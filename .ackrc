
--pager=less
--type-set=pom:is:pom.xml
--type-add=pom:ext:pom
--type-set=mvn:is:pom.xml
--type-add=mvn:ext:pom
--type-set=maven:is:pom.xml
--type-add=maven:ext:pom

--type-add=proto:ext:proto

--type-add=properties:ext:properties
--type-add=properties:ext:properties.*
--type-add=gitignore:is:.gitignore


--type-set=jenkins:is:Jenkinsfile
--type-add=jenkins:is:JenkinsFile
--type-add=jenkins:match:jenkinsfile.*
--type-add=jenkins:match:.*-JenkinsFile
