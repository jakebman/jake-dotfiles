# Docs: https://docs.aws.amazon.com/cli/latest/userguide/cli-usage-alias.html
# Examples: https://github.com/awslabs/awscli-aliases/blob/master/alias
[toplevel]
# This command is *really* pretty with --output table
whoami =
  !f() {
    if [ "$#" -gt 0 ]; then
      aws sts get-caller-identity "$@"
    else
      # "$@" is unnecessary, but keeps parallel structure better
      aws sts get-caller-identity --output yaml "$@"
    fi
  }; f

# NB: not actually SSH
ssh = ssm start-session --reason "(Launched from aws cli. Likely diagnostics related.)" --target

# aws sso login, plus other useful stuff. Logs into docker, too
# NB: sso login applies across all profiles that share an sso session
# TODO: this should pay attention to all other sso sessions.
# Best we can do so far is allow choosing either a --profile or --sso-session
login =
  !f() {
    local jobs # jobs -p doesn't report. Manually tracking it via $!
    if ! aws loggedin-silent; then
      aws sso login "$@" || return
    else
      echo "You're still logged in :D"
    fi

    for profile in $(aws configure list-profiles); do
      # NB: profile argument is given as string, not --profile=... so that it can be output
      aws docker-login "$profile" &
      jobs="${jobs} ${!}" # pid of most-recently-backgrounded process
    done

    local pid
    for pid in $jobs; do
      wait $pid || echo $pid failed somehow
    done
  } ; f

login-docker = docker-login-force

# disable optimism on docker-login
docker-login-force =
  !f() {
    JAKE_AWS_DOCKER_LOGIN_CONFIG="" aws docker-login
  } ; f


docker-login =
  !f() {
    local PROFILE ACCOUNT WHERE DOCKER_CONFIG

    # PROFILE=${1-default}, but with shifting the arg if it is present
    if [ -n "$1" ]; then
      PROFILE="${1}"
      shift
    else
      # The 'default' profile duplicates this, but calling docker-login in a loop *should* skip it for natnav.
      # So, this is 'effectively' the default profile for logging in. But not exactly. But close enough?
      # TODO: this should be configurable
      PROFILE=natnav
    fi

    if aws configure get docker_login_skip_this_profile --profile "$PROFILE" "$@" >/dev/null 2>&1; then
      echo "Skipping docker login for profile $PROFILE - docker_login_skip_this_profile is present"
      return
    fi

    # ACCOUNT="$(aws sts get-caller-identity --query 'Account' --output text --profile "${PROFILE}" "$@")"
    # this command is faster:
    ACCOUNT="$(aws configure get sso_account_id --profile "${PROFILE}" "$@")"
    WHERE="${ACCOUNT}.dkr.ecr.us-east-1.amazonaws.com"
    DOCKER_CONFIG="${JAKE_AWS_DOCKER_LOGIN_CONFIG-${DOCKER_CONFIG-${HOME}/.docker/config.json}}"
    echo "logging into using settings $DOCKER_CONFIG"
    if type jq >/dev/null &&
       jq --exit-status \
          --arg registryUrl "$WHERE" \
          '.auths | has($registryUrl)' \
          "${DOCKER_CONFIG}" \
          >/dev/null \
          2>&1 ; then
        echo "Already found '${PROFILE}' credentials for ${ACCOUNT} repository in ${DOCKER_CONFIG}"
        return
    fi

    echo  "Logging into docker for aws account ${ACCOUNT} using the ${PROFILE} profile at url ${WHERE} ..."
    aws ecr get-login-password --profile "$PROFILE" | docker login -u AWS --password-stdin "$WHERE" >/dev/null
    echo "Successfully logged into ${WHERE}"
  } ; f
# springboard down to other commands. Sometimes aliases.
regions = ec2 regions
loggedin = sso loggedin
loggedin-silent = ! aws loggedin >/dev/null 2>&1
logout = sso logout

forward =
  !f() {
    # NB: all parameter strings are concatenated together. I'm a little uncertain of the mechanism
    # but it's necessary and also useful
    # NB: these parameters are subject to SQL-like injection.
    # ex: aws forward instance "aHost,aNewParameter=aNewValue"
    # TODO: it'd be nice if I could default these values in the aws config (aws configure get myVariableName)
    local instance_id="${1:-i-0351334206111560d}"
    local host="${2:-nns-cache-default-pmtestnnd.redis.nns}"
    local hostPort="${3:-6379}"
    local localPort="${4:-${hostPort}}"
    aws ssm start-session --target "${instance_id:?}" \
      --document-name AWS-StartPortForwardingSessionToRemoteHost \
      --parameters "host=${host},"\
                   "portNumber=${hostPort},"\
                   "localPortNumber=${localPort}"
  } ; f

forward-daemon =
  !f() {
    while true; do
      aws forward "$@"
    done
  } ; f

[command sso]
# aws doesn't natively have this command. Weird. Also, surprisingly verbose
loggedin =
  !f() {
    if aws sts get-caller-identity > /dev/null 2>&1; then
      echo "you're logged in"
    else
      # preserve sts's return code, for whatever that's worth
      local code="$?"
      echo "you are not logged in"
      return "$code"
    fi
  }; f

[command eks]
# TODO: paging
describe-clusters =
  !f() {
    aws eks list-clusters |
      jq -j '.clusters | join ("\u0000")' |
      xargs --null -L 1 aws eks describe-cluster --name |
      jq --slurp 'reduce (.[] | .cluster | {(.name):.}) as $item ({}; . + $item)'
  }; f

# Example from the docs
[command ec2]
regions = describe-regions --query Regions[].RegionName
