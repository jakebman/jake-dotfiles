autologin-exceptions =
  !f() {
    echo autologin-exceptions               # this command itself!
    echo autologin-execptions               # its typo
    echo sso sts help                       # base-level functionality that doesn't need to be interfered with
    echo login loggedin logged-in logout    # my aliases that also don't need this indirection
    echo whoami whomai
    echo "$AWS_CUSTOM_AUTOLOGIN_EXCEPTIONS"
  } ; f

# typo: c/e swapped
autologin-execptions = autologin-exceptions

# Given a commandline invocation, sometimes it might not want autologin functionality
# Otherwise, log in if you're not currently logged in.
# This is just a helper to autologin-and-then. Use aws autologin (no underscore) as a
# shortcut to autologin-and-then
# See also: autologin-exceptions
autologin_ =
  !f() {
    # Move all stdout to stderr, globally within this execution
    # TODO: This "should" be fine. Is it?
    exec >&2

    local login="any string that passes test -n - a non-empty string"

    if [ "$#" -ne 0 ]; then
      local exception
      for exception in $(aws autologin-exceptions); do
        if [ "$exception" = "$1" ]; then
          # TODO: do we squawk here?
          login=
          break
        fi
      done
    fi
    if [ -z "$login" ]; then
      # No login, therefore, we're done!
      return
    elif ! aws loggedin-silent; then
      # We should login
      aws sso login
    elif [ -z "$AWS_CUSTOM_AUTOLOGIN_SILENT" ]; then
      echo "You're already logged in! Woo!"
    fi
  } ; f

autologin_silent = !AWS_CUSTOM_AUTOLOGIN_SILENT=${AWS_CUSTOM_AUTOLOGIN_SILENT-yes,silent} aws autologin_

autologin-and-then =
  !f() {
    aws autologin_silent "$@"

    if [ "$#" -gt 0 ]; then
      aws "$@"
    fi
  } ; f
autologin = autologin-and-then
login-and-then = autologin-and-then

# aws sso login, plus other useful stuff. Logs into docker, too
# NB: sso login applies across all profiles that share an sso session
# TODO: this should pay attention to all other sso sessions.
# Best we can do so far is allow choosing either a --profile or --sso-session
login = !AWS_CUSTOM_AUTOLOGIN_SILENT= aws autologin-and-then docker-login-all
docker-login-all =
  !f() {
    local jobs # jobs -p doesn't report. Manually tracking it via $!

    for profile in $(aws configure list-profiles); do
      # NB: profile argument is given as string, not --profile=... so that it can be output
      aws docker-login "$profile" &
      jobs="${jobs} ${!}" # pid of most-recently-backgrounded process
    done

    local pid
    for pid in $jobs; do
      wait $pid || echo $pid failed somehow
    done
  } ; f

login-docker = docker-login-force

# disable optimism on docker-login
docker-login-force = !JAKE_AWS_DOCKER_LOGIN_CONFIG="" aws docker-login
docker-login-all-force = !JAKE_AWS_DOCKER_LOGIN_CONFIG="" aws docker-login-all
docker-login-force-all = docker-login-all-force


docker-login =
  !f() {
    local PROFILE ACCOUNT WHERE DOCKER_CONFIG

    # PROFILE=${1-default}, but with shifting the arg if it is present
    if [ -n "$1" ]; then
      PROFILE="${1}"
      shift
    else
      # The 'default' profile duplicates this, but calling docker-login in a loop *should* skip it, because natnav is "better" for the task.
      # So, this is 'effectively' the default profile for logging in. But not exactly. But close enough?
      # TODO: this should be configurable
      PROFILE=natnav
    fi

    if aws configure get docker_login_skip_this_profile --profile "$PROFILE" "$@" >/dev/null 2>&1; then
      echo "Skipping docker login for profile $PROFILE - docker_login_skip_this_profile is present"
      return
    fi

    # ACCOUNT="$(aws sts get-caller-identity --query 'Account' --output text --profile "${PROFILE}" "$@")"
    # this command is faster:
    ACCOUNT="$(aws configure get sso_account_id --profile "${PROFILE}" "$@")"
    WHERE="${ACCOUNT}.dkr.ecr.us-east-1.amazonaws.com"
    DOCKER_CONFIG="${JAKE_AWS_DOCKER_LOGIN_CONFIG-${DOCKER_CONFIG-${HOME}/.docker}}"
    if type jq >/dev/null &&
       jq --exit-status \
          --arg registryUrl "$WHERE" \
          '.auths | has($registryUrl)' \
          "${DOCKER_CONFIG}"/config.json \
          >/dev/null \
          2>&1 ; then
        echo "Already found ${PROFILE} (${ACCOUNT}) credentials in ${DOCKER_CONFIG}/config.json"
        return
    fi

    if aws ecr get-login-password --profile "$PROFILE" | docker login -u AWS --password-stdin "$WHERE" >/dev/null; then
      echo "Logged in to docker for ${PROFILE} (${ACCOUNT}) at url ${WHERE}"
    else
      >&2 echo "FAILED to login to docker for ${PROFILE} (${ACCOUNT}) at url ${WHERE}"
    fi
  } ; f
