# typo:
forware = forward
# TODO: this is redundant once I can `ssh -L 6379:nns-cache-default-pmtest2nnd.redis.nns:6379 i-0351334206111560d`
# Thanks, SSM
forward =
  !f() {
    # NB: all parameter strings are concatenated together. I'm a little uncertain of the mechanism
    # but it's necessary and also useful
    # NB: these parameters are subject to SQL-like injection.
    # ex: aws forward instance "aHost,aNewParameter=aNewValue"
    # TODO: it'd be nice if I could default these values in the aws config (aws configure get myVariableName)
    local instance_id="${2:-i-0351334206111560d}" # "slate-natnavdev-bastion-tunnel"
    local host="${1:-nns-cache-default-pmtest2nnd.redis.nns}"
    local hostPort="${3:-6379}"
    local localPort="${4:-${hostPort}}"
    echo "This functionality is now also available via:"
    echo "ssh -L '${localPort}:${host}:${hostPort}' ${instance_id}"
    aws ssm start-session --target "${instance_id:?}" \
      --document-name AWS-StartPortForwardingSessionToRemoteHost \
      --parameters "host=${host},"\
                   "portNumber=${hostPort},"\
                   "localPortNumber=${localPort}"
  } ; f

forward-daemon =
  !f() {
    while true; do
      aws forward "$@"
    done
  } ; f

# A helper method. Doesn't actually need to live in awscli-land, but it's convenient to keep it close.
# Essentially: run jq, with color if reasonable (TODO: if awscli wants color output); with paging if reasonable.
# TODO I'd like to learn JMESPath so can just become a `--query=...` flag instead.
jq-paged =
  !f() {
    local colorArg
    if [ -t 1 ]; then
      colorArg=--color-output
    fi
    jq $colorArg "$@" | less --RAW-CONTROL-CHARS
  } ; f

[command sso]
# aws doesn't natively have this command. Weird. Also, surprisingly verbose
loggedin =
  !f() {
    if aws sts get-caller-identity > /dev/null 2>&1; then
      echo "you're logged in"
    else
      # preserve sts's return code, for whatever that's worth
      local code="$?"
      echo "you are not logged in"
      return "$code"
    fi
  } ; f

[command eks]
describe-clusters =
  !f() {
    aws eks list-clusters |
      jq -j '.clusters | join ("\u0000")' |
      xargs --null -L 1 aws eks describe-cluster --name |
      aws jq-paged --slurp 'reduce (.[] | .cluster | {(.name):.}) as $item ({}; . + $item)'
  } ; f

# Example from the docs
[command ec2]
ls = list
list =
  !f() {
    # TODO: it would be nice to recognize a flag to expand to "Name=instance-state-name,Values=running"
    aws ec2 describe-instances "$@" |
      aws jq-paged '.Reservations[].Instances[] | {name: (.Tags[] | select(.Key == "Name") |.Value) , ip: [.NetworkInterfaces[].PrivateIpAddresses[].PrivateIpAddress][0] , id: .InstanceId}'
  } ; f

search =
  !f() {
    aws ec2 list --filter "Name=tag-key,Values=Name" "Name=tag-value,Values=*${1?need a name}*"
  } ; f

regions = describe-regions --query Regions[].RegionName
