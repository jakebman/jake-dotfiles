#!/usr/bin/env -S java --source 15
//
// gen-fontconfig  —  generate a JDK fontconfig.properties from the
// system's live fontconfig resolution, so the JDK never falls back to
// synthesising one (which reads/writes ~/.java/fonts via FcFontConfiguration).
//
// USAGE
//   ./gen-fontconfig > ~/.config/java/custom-fontconfig.properties
//
// Then point any JDK 8..25 at the GENERATED FILE:
//   java -Dsun.awt.fontconfig=/path/to/your/custom-fontconfig.properties ...
//
// LOGICAL-FAMILY  ->  FONTCONFIG-GENERIC EQUIVALENCES (baked in, documented)
//   The JDK has five logical families. fontconfig has three generic aliases
//   (serif, sans-serif, monospace). The mapping below mirrors what the JDK's
//   own FcFontConfiguration effectively does:
//
//     JDK logical    fontconfig generic   rationale
//     -----------    ------------------   --------------------------------------
//     serif          serif                direct equivalent
//     sansserif      sans-serif           direct equivalent
//     monospaced     monospace            direct equivalent
//     dialog         sans-serif           no fontconfig generic for "dialog";
//                                          the JDK treats it as a sans-serif UI
//                                          font, so we resolve it via sans-serif.
//     dialoginput    monospace            no fontconfig generic for
//                                          "dialoginput"; it is the fixed-width
//                                          input face, so we resolve it via
//                                          monospace.
//
//   Consequence of the two indirect mappings: dialog and dialoginput will
//   resolve to the SAME physical files as sansserif and monospaced
//   respectively. That matches historical JDK behaviour and is intentional.

import java.io.ByteArrayOutputStream;
import java.io.File;
import java.nio.charset.StandardCharsets;
import java.util.Properties;

public class gen_fontconfig {

    /**
     * The five JDK logical font families. Enum declaration order IS the output
     * order, so the generated file is deterministic and diffable without
     * relying on any map implementation's iteration order.
     *
     * Each constant carries:
     *   logical   — the JDK logical family key (e.g. "sansserif")
     *   generic   — the fontconfig generic used to resolve it (see class header
     *               for why dialog -> sans-serif and dialoginput -> monospace)
     *   base      — the capitalised component-font base name (e.g. "SansSerif")
     */
    enum Family {
        SERIF       ("serif",       "serif",      "Serif"),
        SANSSERIF   ("sansserif",   "sans-serif", "SansSerif"),
        MONOSPACED  ("monospaced",  "monospace",  "Monospaced"),
        DIALOG      ("dialog",      "sans-serif", "Dialog"),       // see header
        DIALOGINPUT ("dialoginput", "monospace",  "DialogInput");  // see header

        final String logical;
        final String generic;
        final String base;

        Family(String logical, String generic, String base) {
            this.logical = logical;
            this.generic = generic;
            this.base = base;
        }
    }

    /**
     * The four JDK font styles. Declaration order IS the output order.
     *
     * Each constant carries:
     *   key             — the JDK style suffix (e.g. "bolditalic")
     *   selector        — fontconfig weight/slant selectors appended to the
     *                     generic to form the match pattern (e.g. ":weight=bold")
     *   componentSuffix — appended to a family base to form the component font
     *                     name (e.g. base "Serif" + " Bold" -> "Serif Bold")
     */
    enum Style {
        PLAIN      ("plain",      "",                          ""),
        BOLD       ("bold",       ":weight=bold",              " Bold"),
        ITALIC     ("italic",     ":slant=italic",             " Italic"),
        BOLDITALIC ("bolditalic", ":weight=bold:slant=italic", " Bold Italic");

        final String key;
        final String selector;
        final String componentSuffix;

        Style(String key, String selector, String componentSuffix) {
            this.key = key;
            this.selector = selector;
            this.componentSuffix = componentSuffix;
        }
    }

    public static void main(String[] args) throws Exception {
        boolean fcAvailable = fcMatchAvailable();

        Properties props = new Properties();

        // Accumulated diagnostics. Each line becomes part of the store()
        // `comments` block at the top of the file. Properties.store() prefixes
        // every line of this string with '#', so we do not add it ourselves.
        StringBuilder comments = new StringBuilder();
        comments.append("JDK logical-font configuration generated by gen-fontconfig\n");
        comments.append("from live fontconfig (fc-match) resolution on this host.\n");
        comments.append("Use with: -Dsun.awt.fontconfig=<path-to-this-file>\n");
        comments.append("Supplying this file suppresses FcFontConfiguration, so the JDK\n");
        comments.append("never reads or writes ~/.java/fonts.");

        if (!fcAvailable) {
            comments.append("\nWARNING: fc-match is unavailable; no filename.* entries are written");
            comments.append("\nand every logical family falls back to the JDK built-in default.");
        }

        props.setProperty("version", "1");
        props.setProperty("sequence.allfonts", "default");

        // Logical family -> component (physical) font name. Constant, but kept
        // in the same Properties so the whole file is one store() call.
        for (Family fam : Family.values()) {
            for (Style st : Style.values()) {
                String componentName = fam.base + st.componentSuffix;
                props.setProperty(fam.logical + "." + st.key, componentName);
            }
        }

        // Component font name -> file. fc-match always exits 0 (always falls
        // back), so success is judged by whether the resolved path exists.
        if (fcAvailable) {
            for (Family fam : Family.values()) {
                for (Style st : Style.values()) {
                    String componentName = fam.base + st.componentSuffix;
                    String key = "filename." + componentName.replace(' ', '_');
                    String pattern = fam.generic + st.selector;

                    String file = fcMatchFile(pattern);
                    if (file == null || file.isEmpty()) {
                        comments.append("%nWARNING: fc-match returned no file for %s.%s (pattern '%s'); omitting %s, so this face falls back to the JDK default."
                                .formatted(fam.logical, st.key, pattern, key));
                    } else if (!new File(file).isFile()) {
                        comments.append("%nWARNING: %s.%s (pattern '%s') resolved to a non-existent file; omitting %s, so this face falls back to the JDK default."
                                .formatted(fam.logical, st.key, pattern, key));
                    } else {
                        props.setProperty(key, file);
                    }
                }
            }
        }

        props.store(System.out, comments.toString());
    }

    /** True if fc-match is runnable. (Resolution success is judged separately,
     *  by file existence, because fc-match always exits 0.) */
    private static boolean fcMatchAvailable() {
        try {
            Process p = new ProcessBuilder("fc-match", "--version")
                    .redirectErrorStream(true).start();
            read(p.getInputStream());
            return p.waitFor() == 0;
        } catch (Exception ex) {
            return false;
        }
    }

    /**
     * Resolve a fontconfig pattern to a file path. fc-match ALWAYS exits 0 (it
     * always falls back to some font), so callers must judge success by whether
     * the returned path exists, not by exit code. Returns the raw path (which
     * may legally contain any byte except NUL), or null on process error.
     */
    private static String fcMatchFile(String pattern) {
        try {
            // --format %{file} emits exactly the path with no trailing newline.
            Process p = new ProcessBuilder("fc-match", "--format", "%{file}", pattern).start();
            String stdout = read(p.getInputStream());
            read(p.getErrorStream());
            p.waitFor();
            return stdout;
        } catch (Exception ex) {
            return null;
        }
    }

    /** Read a stream fully as UTF-8, preserving all bytes including newlines. */
    private static String read(java.io.InputStream in) throws Exception {
        ByteArrayOutputStream bos = new ByteArrayOutputStream();
        byte[] buf = new byte[4096];
        int n;
        while ((n = in.read(buf)) != -1) {
            bos.write(buf, 0, n);
        }
        return new String(bos.toByteArray(), StandardCharsets.UTF_8);
    }
}
