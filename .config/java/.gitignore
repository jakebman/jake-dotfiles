
# These files are deeply nested, but the .gitignore rules can reach them from here
# They don't need to be ever tracked
.user.lock.*
.userRootModFile.*

# IntelliJ settings when it runs in WSL-land don't need to be sync'd
.java/.userPrefs/jetbrains

# Almost all prefs are ignorable. Ex: JShell/prefs.xml ends up being just a command history.
# That's noot an XDG 'config', but 'state' or 'cache', but I don't feel like relocating it
prefs.xml
