[user]
	# NB: these are intentionally overridden in work-config [include].path'd at the end of this file
	name = Jake Boeckerman
	email = jakebman@gmail.com
[alias]
	# TODO: if any of these categories become onery, I can just break them out into include sections
	# Typos (alphabetical by correct name) ("I mashed my keyboard and expected this to work")
	ad = add
	addp = add -p
	aliases = alias # git-alias is in git-extras. Sometimes I expect the plural to work
	alises = aliases
	pb = bp # alias defined below to do big-picture stuff implicitly
	comit = commit
	comm0t = commit
	comm9t = commit
	comm-t = commit
	commt = commit
	ocmmit = commit
	commitm = commit -m # TODO: would be nice if no-args to this didn't produce an error, but instead a message editor
	commitmp = commitpm
	commitp = commitpm
	commitpm = addp-and-commitm
	config-deubg = config-debug
	deltaAdd = delta-add
	deltaDiff = delta-diff
	deltaLog = deltalog
	edit-config = config-edit
	d = implicitdiff
	dff = diff
	dif = diff
	idff = diff
	tgui = gui
	thelp = help
	ehlp = help
	hlep = help
	idiff = implicitdiff
	intend = intent-to-add # convenient name below
	intent = intent-to-add
	jstg = j --staged
	jdf = j --diff
	jmg = j --merge
	jws = j --ws
	oroboros = ouroboros
	tpush = push
	pus = push
	restorep = restore -p
	# Should 'stat' be a typo for status or stats?
	statu = status
	stashs = stash
	tatus = status
	workdir = worktree # geez.

	## Convenient Names ("I typed something intentionally and expected it to work (often this promotes a flag to a command)")
	amend = commit --amend # NB: the bash version of this command leverages my smart commit command
	autostash = pull --rebase --autostash # My brain also expects an implicit rebase when I'm talking about autostash
	bare = clone --bare
	branches = branch -a # Originally a typo from bash-land, I realized this could be an even better command
	bp = "!f() { \n\
		: big-picture; \n\
		if test \"$#\" -eq 0; then \n\
			git big-picture -v x-www-browser; \n\
		else \n\
			git big-picture \"$@\"; \n\
		fi \n\
		} ; f"
	co = checkout
	config-editg = config edit --global
	config-editl = config edit --local # --local is unnecessary, but provides clarity
	config-edit = config-editg
	# delta is a utility defined below
	delta-add = delta add --patch # --patch is implied if you're adding with delta
	delta-diff = delta diff
	delta-log = delta log --patch # --patch is implied if you're going to send log to delta
	ignored = status --ignored --untracked=normal # an ignored file isn't listed if it's also untracked unless you're also listing untracked files
	intent-to-add = add --intent-to-add
	no-columns = -c column.ui=never -c column.branch=never -c column.clean=never -c column.status=never -c column.tag=never # disable columning in a further git command

	# borrowed from my bash-implicit-git function `remote`, which we can't offer here, but its `remotes` alias can be duplicated here
	remotes = "!f() { \n\
		: remote; \n\
		if test \"$#\" -eq 0 || test show = \"$1\"; then \n\
			git remote -v \"$@\"; \n\
		else \n\
			git remote \"$@\" ; \n\
		fi \n\
		} ; f"
	submodules = submodule # arguably a typo, but I thought this was a proper command name

	shallow = clone --depth 1
	stats = show --stat
	unshallow = fetch --unshallow
	unstash = stash pop
	untracked = status --untracked
	up = pull
	# stage = diff --staged # Fails, because stage is already a command
	staged = diff --staged
	logp = log --patch
	logs = log --stat
	logn = log --numstat

	# see pretty.jake, which is my custom formatting, defined in pretty.jake
	log-oneline = log --pretty=jake
	log-nodate  = log --pretty=jake-nodate

	rainbow = log-oneline --graph
	rainbow-here = rainbow # for legacy clarity to myself
	# NNS stores argo information in the argo_manifests branch. THAT IS NOT A REASONABLE BRANCH
	# (NB: the --exclude *must specifically* come before the --all, per git help log)
	rainbow-all = rainbow --exclude=*argo_manifests --all

	# cute aliases, inspired by https://stackoverflow.com/a/52896091/285944, sharing my common oneline alias above
	r  = rainbow-all # convenience name
	l  = rainbow
	# don't want rainbow here - stats really don't rainbow nicely
	ll = log-oneline --date=iso   --numstat
	# ld is equivalent to `rainbow --date=short`, but has different semantics.
	# This spelling prevents concidental changes to rainbow from affecting ld
	ld = log-oneline --date=short --graph
	# Prompted by the discussion on ld, this is actually the variant that *does* trust rainbow
	lr = rainbow     --date=short
	ls = log-oneline

	man = help
	# list git merges, and permit -p to turn them into patches
	# (Specifically, we don't want to FORCE patches on, but it SHOULD be *as easy as possible*)
	merges = log --merges -m

	# Abuse parameter passing - the 'yesterday' argument will pass to --since, but if we do something dumb, we'll get something dumb back.
	# (Also, we choose since-as-filter to get around weird history hiccups that things like cherry-picking can introduce)
	since = log --since-as-filter
	# TODO: it'd be *really* cool if "yesterday" implicitly meant "Friday" if today is Monday (nb: `date +%A`)
	yesterday = since yesterday
	tags = tag -l
	unstage = restore --staged

	## Utilities ("I didn't expect this to work, but I'm causing it to work anyway :D")
	# These'll more likely than not use the function tech from https://www.atlassian.com/blog/git/advanced-git-aliases
	# Also, multiline functions are strings with backslashes on the newlines. See https://stackoverflow.com/a/28502292/285944
	# (and also the `: <git-command>` completion assistance is covered in a comment there
	# I only really feel these tools to be useful if there's more than one relevant command in the function
	# TL;DR: this prevents unexpected parameters from being appended to the tail of these commands (which don't expect as many as their parent commands)
	addp-and-commitm = "!f() { git addp && git commitm \"$@\" ; } ; f"

	# re-implementing git-alias from git-extras to respect multi-line strings and use git-config subcommands
	# TODO: I think the grep phrase is the best filtering I can do - it permits ^
	# TODO: some magic to set a pager of `bat --language=bash` for this command only? [pager]alias=... perhaps?
	alias2 = "!f() { \n\
		case $# in \n\
		0|1) \n\
			git config get --all --show-names --regexp -z '^alias\\.' | \n\
				sed -z -E 's/^alias\\.([^\\n]+)\\n/\\1 = /g' | \n\
				grep -z -E -e \"$1\" | \n\
				sort -z | \n\
				tr '\\0' '\\n' | \n\
				$(git var GIT_PAGER); \n\
		;; \n\
		2) \n\
			git config set --global \"$1\" \"$2\"; \n\
		;; \n\
		*) \n\
			>&2 echo \"Too many arguments\"; \n\
			cat <<-'HEREDOC'; \n\
			usage: git alias                  # list aliases \n\
			   or: git alias <regex>          # aliases matching a regex \n\
			   or: git alias <name> <command> # create alias \n\
			HEREDOC\n\
			# NB: HEREDOC requires no space before line termination \n\
			return 1; \n\
		;; \n\
		esac \n\
		} ; f"

	# TODO: this is from https://stackoverflow.com/questions/14365946/create-a-branch-alias
	#  and I'm not certain if it has any nasty consequences if I later want to create a proper
	#  branch for main
	branch-alias = "!f() { \n\
		local newBranch existingBranch; \n\
		newBranch=${1:?need a name for the new branch}; \n\
		existingBranch=${2}; \n\
		if [ -z \"$existingBranch\" ]; then \n\
			if ! existingBranch=\"$(git current-branch 2>/dev/null)\" ; then \n\
				>&2 echo not on a current branch. Please specify a branch to alias from; \n\
				return 1; \n\
			fi \n\
		fi; \n\
		if ! git commit-ish-exists \"$existingBranch\"; then \n\
			>&2 echo \"cannot create alias $newBranch for $existingBranch - $existingBranch does not exist \"; \n\
			return 1; \n\
		elif git commit-ish-exists \"$newBranch\"; then \n\
			>&2 echo \"cannot create alias $newBranch for $existingBranch - $newBranch already exists\"; \n\
			return 1; \n\
		else \n\
			git symbolic-ref refs/heads/main refs/heads/master && \n\
			echo \"successfully aliased $newBranch for $existingBranch\"; \n\
		fi \n\
		} ; f"
	branch-alias-main-for-master = branch-alias main master

	arguments-debug = "!f(){ \n\
		for i; do \n\
			echo \"'$i'\"; \n\
		done ; \n\
		} ; f"
	# https://stackoverflow.com/questions/2363197/can-i-get-a-list-of-files-marked-assume-unchanged/2363495#2363495
	# (leveraging the function tech defined below)
	assumed-unchanged = "!f() { git ls-files -v | grep \"^[[:lower:]]\" ; } ; f"

	# NB: the git-authors command from git-extras is psychotic - it appends to any existing file with a certain name regex
	# WHICH HAPPENS TO MATCH ITS OWN SCRIPT NAME.  Hence, why I'm calling it psychotic.
	authors = "!f() { git shortlog -s -e \"$@\" | awk '{$1=\"\";print}' | sort -f ; } ; f"
	no-mailmap = !git -c mailmap.file=/dev/null -c mailmap.blob=0000000:/dev/null
	authors-raw = no-mailmap authors
	# sort:
	# -t: field separator
	# -f: ignore case
	# -k: sort on k'th field
	authors-by-email = "!f() { git authors \"$@\" | sort -f -k2 -t'<' ; } ; f"

	# List files touched by a particular user, defaulting to use the current git user.name
	# (THESE FILES ARE NOT GUARANTEED TO EXIST b/c they can later be deleted)
	# see https://superuser.com/a/1792567/137598
	# The factored-out common worker. First argument is a diff-filter, second is the optional author regex
	by-author = "!f() { git log --author=\"${2:-$(git config get user.name)}\" --format='' --diff-filter=\"$1\" --name-only --no-commit-id | sort | uniq ; } ; f"
	created-by-author = by-author A
	deleted-by-author = by-author D
	touched-by-author = by-author r # Anything except a Rename
	renamed-by-author = by-author R # Renames - the NEW name

	# TODO: if stdout is tty, print "$1 exists" or "$1 doesn't exist in git as a commitish object"
	# ref: EXAMPLES section of `man git-rev-parse`
	commit-ish-exists = "!f() { git rev-parse --verify --end-of-options ${1?}^{commit} >/dev/null 2>&1 ; } ; f"
	# ref: https://stackoverflow.com/questions/6245570/how-do-i-get-the-current-branch-name-in-git
	# NB: git branch --show-current is less good - succeeds with empty string in detached head state
	current-branch = "!f() { git symbolic-ref --short HEAD ; } ; f"
	# Read this as "run git in a delta-like mode for this current interaction"
	# And don't confuse it with my bash alias for delta, which uses *this* to invoke git-implicitdiff
	# NB: the [delta] sections below configures the particular --features I'm using here
	delta = !git -c core.pager='delta --features=git-pager' -c interactive.diffFilter='delta --features=diff-filter'
	env = "!f() { echo EDITOR=$EDITOR; set ; } ; f"
	gitdir = "!f() { git rev-parse --absolute-git-dir ; } ; f"
	# --local is unnecessary, but provides clarity
	ignore-untracked =  "!f() { git config set --local status.showUntrackedFiles no ; } ; f"
	# this isn't ideal - some "natural" answers actually don't work (and are grep -v'd away) like git-svn
	# I'd like to use `git help $x`, but that fails for git-j, git-rscp and others w/o man pages
	# The grep -v phrasing excludes some specific external commands that are false positives
	# This might also be improved if we leverage the `git --list-cmds=...` INTERNAL/EXPERIMENTAL tech from /usr/share/bash-completion/completions/git
	# The list of values is in https://github.com/git/git/blob/21306a098c3f174ad4c2a5cddb9069ee27a548b0/git.c#L88
	# And categories are listed in https://github.com/git/git/blob/master/command-list.txt, used by https://github.com/git/git/blob/21306a098c3f174ad4c2a5cddb9069ee27a548b0/help.c#L382
	# But: Heads up! git --list-cmds=list-foreignscminterface still lists these cvs-y things, so is still over-broad
	# This seems to be because those commands live as dependencies of apt's git-all
	# TODO: `git is-valid-git-command --help` succeds by printing this alias.
	# But `git is-valid-git-command -- --help` fails, because `--` is not a command.
	is-valid-git-command = "!f() { git help -a | grep -v -E '^\\s(cvs|p4|send-email|sh-)' | grep -q -s -E \"^\\s+${1?Need a value}\\b\" ; } ; f"
	# --local is unnecessary, but provides clarity
	silence-mr-pull =  "!f() { git config set --local merge.stat no ; } ; f"
	ouroboros = "!f() { git remote add ouroboros \"$(git rev-parse --absolute-git-dir)\" ; } ; f"
	# named from https://stackoverflow.com/questions/16163829/git-get-effective-git-dir-if-current-dir-is-a-working-tree-subdir-and-git-dir
	show-git-dir = rev-parse --git-dir
	unpaged = !git --no-pager

	# Stolen from mr's git_status action
	# TODO: --simplify-by-decoration is a good "trim the tree to relevant bits" flag. Potentially use it in more places
	# TODO: I'd also like the upstream mr-status to list commits from local branches that aren't pushed to their tracked branches
	mr-status = "!f() { \n\
			git status -s \"$@\"; \n\
			git --no-pager log --branches --not --remotes --simplify-by-decoration --decorate --oneline; \n\
			git --no-pager stash list; \n\
		} ; f"

	# TODO: also need to expire the reflog with  git reflog expire --expire=all --all, per https://stackoverflow.com/a/62650346/285944
	# TODO: also might need to repack, per a peer answer: https://stackoverflow.com/a/53245223/285944
	# In fact, it might be nice to 'stash' two files - one for the tags and one for the reflog so they can be restored
	# Alternatively, following github's "Here are your local changes. Please type the name of this repo to proceed" prompt might be cool, too
	# I should also do something along the lines of "create a shallow (--depth=1) clone; compare its .git dir's size"
	reshallow = "!f() { \n\
			echo 'deleting tags:'; \n\
			git show-ref --tags; \n\
			git tag -d $(git tag -l); \n\
			git pull --rebase --no-tags --depth 1; \n\
			git gc --prune=all; \n\
		} ; f"
[fetch]
	all = true   # Fetch should assume --all. Thank you git 2.44 :D
	parallel = 0 # zero means "some reasonable (non-1) default"; the default value is 1
[checkout]
	defaultRemote = origin
[init]
	defaultBranch = main
[lfs]
	locksverify = false
[push]
	autoSetupRemote = true
[help]
	autoCorrect = prompt
[core]
	# almost every paged output that I care about is going to prefix the tabbed output with a +/-/' ' character
	# this shifts my normal --tabs=2 over by that one character
	pager = less --tabs=3,5
[pager]
	status = true # `git status` should always use a pager
	show-branch = true # ditto
	help = true
[column]
	ui = auto
[diff]
	context = 5
	tool = vimdiff
	mnemonicPrefix = true
	colorMoved = default # uses blue/purple for moved lines. Very pretty :)
[delta]
	# Leverage delta features to get cool behaviors. Our default-feature sets tabs to 4. That means
	# that I'll get that whenever I invoke the delta executable directly.
	# But that gets overwritten when we're using 'delta.exe' in our 'git-delta' alias because those commands
	# specifically specify those --features.
	# When that happens, the git-delta pagers end up using natural tabs instead of configured-width tabs
	features = default-feature
	tabs = 0 # print tabs naturally - respect `tabs` setting in the terminal
[delta "default-feature"]
	tabs = 4
[delta "diff-filter"]
	color-only = true
[delta "git-pager"]
	max-line-length = 0 # Don't wrap lines
[blame]
	date = human-local
[submodule]
	# Allow submodule recursion everywhere. This gets thorny with mr fetching bat's 85(!) submodules,
	# but it's really useful where I want it to be, and as long as I put out that fire
	recurse = true
[pretty]
	# Impl. notes:
	# This used to be a raw --pretty invocation (from the stackoverflow link for the l,ll,ls alias variants)
	# but it is sooo much cleaner here!
	# This will almost always be paired with --date=human-local from log.date, below
	# I use an explicit tformat, instead of the implicit one you get by setting --pretty with a %-substitution
	# I use tformat over format, because I like the terminator semantics over the separator syntax
	# (I want the final newline, and since I'm making a oneline-like format, I benefit from
	#    "This means that the final entry of a single-line format will  be properly terminated
	#     with a new line, just as the "oneline" format does")
	# %h: abbreviated commit hash. Auto-colors with color.diff.commit
	# %ad: author date, respecting --date=..., and log.date (log.date is set to human-local)
	# %d: decorations. Auto-colors with color.decorate.*, and color.diff.commmit for the parens, commas, etc.
	# %s: commit subject
	# %aN: author name, respecting mailmap
	# TODO: It'd be really cool to get a field which can be empty which is approximately
	#       "committer name, but blank if it is identical to the author", so we could leverage
	#       these behaviors from git-log's man page:
	#  If you add a + (plus sign) after % of a placeholder, a line-feed is inserted immediately before the expansion if and only if the placeholder expands to a non-empty string.
	#  If you add a - (minus sign) after % of a placeholder, all consecutive line-feeds immediately preceding the expansion are deleted if and only if the placeholder expands to an empty string.
	#  If you add a ` ` (space) after % of a placeholder, a space is inserted immediately before the expansion if and only if the placeholder expands to a non-empty string.
	jake = tformat:%C(auto)%h %C(green)%ad%C(auto)%d %C(reset)%s %C(blue)[%aN]
	# Abuse empty string concatenation to get these to line up even though I drop stuff out of it
	jake-nodate = tformat:%C(auto)%h""""""""""""""%d %C(reset)%s %C(blue)[%cN]
[log]
	# ask git log to act as if --follow is always present
	follow = true
	# get relative dates when it's short, otherwise good dates anyway
	date = human-local
	# --diff-merges=on should behave like --diff-merges=first-parent. show -m, too.
	# This especially helps the git-merges alias above to simply have -m and get these first-parent diffs
	diffMerges = first-parent
[commit]
	verbose = true


