[user]
	# NB: these are intentionally overridden in work-config [include].path'd at the end of this file
	name = Jake Boeckerman
	email = jakebman@gmail.com
[completion]
	# NB: tabs in this string are considered command words - \t-command is considered a positive entry
	# NB: the cases aren't as you expect - the deltaAdd alias is removed via -deltaadd
	commands = \
        -"traditional-typos" \
        -pb -ad -addp -alais -alises -comit -comm0t -comm9t -comm-t \
        -commt -config-deubg -dff -dif -idff -tgui -thelp -ehlp -hlep \
        -oroboros -pus -tpush -statu -stashs -tatus \
        -ocmmit -aliases \
    \
        -"convenient-names" \
        -d -r \
        -delta-add -deltaadd -delta-diff -deltadiff -delta-log -deltalog \
        -intent -workdir -idiff \
    \
        -"commands-I-don't-care-for" \
        -am -force-clone \
        -mr -pr \
    \
        -"commands-that-confound-and/or-confuse-me" \
        -pbuilder -deborig \
    \
        -"git--list-cmds=list-foreignscminterface(the-broken-ones-at-least)" \
        -archimport -cvsexportcommit -cvsimport -cvsserver -p4 -send-email -svn \

	# NB: these are not used by git but instead by my custom command checking aliases below
	list-categories = list-ancillaryinterrogators list-ancillarymanipulators list-complete list-developerinterfaces list-foreignscminterface list-guide list-mainporcelain list-plumbinginterrogators list-plumbingmanipulators list-purehelpers list-synchelpers list-synchingrepositories list-userinterfaces
	# all non-(list-) categories except nohelpers, parseopt, and config, which are special/filtering/weird
	# This config serves as my source of truth for the non-(list-) --list-cmds values I am aware of
	# This is "most list-cmds categories EXCEPT FOR:
	# * nohelpers, which is only a removal filter
	# * config, which list-commands unconditionally automatically appends
	# * parseopt, which seems to be considered invalid next to any other values, but is fine as a single value
	# TODO: does parseopt have an identity relationship with any other set of categories
	most-categories = builtins main others alias
	# The list of categories used by normal bash completion.
	# If GIT_COMPLETION_SHOW_ALL_COMMANDS is specified, builtins is also pre-pended
	most-bash-completion-categories = list-mainporcelain others nohelpers alias list-complete
	# Commands that, despite all evidence to the contrary, git considers to potentially be valid git commands. Formatted to be compatible with completion.commands
	# Vaguely, these are essentially 'other' commands that git sorta just expects to exist
	# They come from list-foreignscminterface and list-purehelpers, and aren't in any other categories
	# Oddly, git-lfs is *actually* an 'other' command, but is still listed, evn if it's missing. That tastes like a bug.
	# I speculate it gets introduced by CI scripts that install git-lfs I'll.. just live with that
	# edit: NOPE!!!! IT IS git-lfs.exe from the WINDOWS PATH that got brought in!
	# (12:03:20) ○ [jakebman@Ubuntu] /mnt/c/Program Files/Git/cmd
	# → IFS=: read -ra ELEM <<<"$PATH"
	# (12:03:55) ○ [jakebman@Ubuntu] /mnt/c/Program Files/Git/cmd
	# → for i in "${ELEM[@]}"; do PATH="$i" /usr/bin/git -c completion.commands= --list-cmds=others | grep lfs && echo $i; done
	# lfs
	# /mnt/c/Program Files/Git/cmd
	invalid-commands = -archimport -cvsexportcommit -cvsimport -cvsserver -p4 -send-email -sh-i18n -sh-setup -svn

# A variant of safe.directory; a whitelist for my git-allow-aliases-to-shadow-builtins command
[safe "aliases"]
	alias = remote

[alias]
	# TODO: if any of these categories become onery, I can just break them out into include sections
	# Typos (alphabetical by correct name) ("I mashed my keyboard and expected this to work")
	ad = add
	addp = add -p
	aliases = alias # git-alias is in git-extras. Sometimes I expect the plural to work
	alais = alias
	alises = aliases
	pb = bp # alias defined below to do big-picture stuff implicitly
	comit = commit
	comm0t = commit
	comm9t = commit
	comm-t = commit
	commt = commit
	ocmmit = commit
	commitmp = commitpm
	commitp = commitpm
	commitpm = addp-and-commitm
	config-deubg = config-debug
	debug-alias = alias-debug
	deltaAdd = delta-add
	deltaDiff = delta-diff
	deltaLog = deltalog
	edit-config = config-edit
	d = implicitdiff
	dff = diff
	dif = diff
	idff = diff
	tgui = gui
	thelp = help
	ehlp = help
	hlep = help
	idiff = implicitdiff
	intend = intent-to-add # convenient name below
	intent = intent-to-add
	jstg = j --staged
	jdf = j --diff
	jmg = j --merge
	jws = j --ws
	oroboros = ouroboros
	tpush = push
	pus = push
	restorep = restore -p
	# Should 'stat' be a typo for status or stats?
	statu = status
	stashs = stash
	tatus = status
	workdir = worktree # geez.

	## Convenient Names ("I typed something intentionally and expected it to work (often this promotes a flag to a command)")
	amend = commit --amend # NB: the bash version of this command leverages my smart commit command
	autostash = pull --rebase --autostash # My brain also expects an implicit rebase when I'm talking about autostash
	bare = clone --bare
	branches = branch -a # Originally a typo from bash-land, I realized this could be an even better command
	bp = "!f() { \n\
		: big-picture; \n\
		if test \"$#\" -eq 0; then \n\
			git big-picture -v x-www-browser; \n\
		else \n\
			git big-picture \"$@\"; \n\
		fi \n\
		} ; f"
	co = checkout
	# This "should" be a typo of 'commit -m', but I want the ergonomics of no complaints if no arguments
	commitm = "!f() { \n\
		if test \"$#\" -eq 0; then \n\
			git commit; \n\
		else \n\
			git commit -m \"$@\"; \n\
		fi \n\
		} ; f"
	config-editg = config edit --global
	config-editl = config edit --local # --local is unnecessary, but provides clarity
	config-edit = config-editg
	config-todos = !j TODO $(git var GIT_CONFIG_GLOBAL)
	# delta is a utility defined below
	delta-add = delta add --patch # --patch is implied if you're adding with delta
	delta-diff = delta diff
	delta-log = delta log --patch # --patch is implied if you're going to send log to delta
	ignored = status --ignored --untracked=normal # an ignored file isn't listed if it's also untracked unless you're also listing untracked files
	# add --intent-to-add, but also implicitly `touch` files that don't exist, including their parent folders
	intent-to-add = "!f() { \n\
		for arg; do \n\
			# TODO: getopt, git-rev-parse, or *something* more canoncial than 'skip arguments if they start with dash' \n\
			if [ \"x${arg}\" = \"x${arg#-}\" ] && ! [ -f \"${arg}\" ]; then \n\
				# https://unix.stackexchange.com/questions/573047/how-to-get-the-relative-path-between-two-directories \n\
				arg=$(realpath --canonicalize-missing --relative-to=\"$(git rev-parse --show-toplevel)\" \"$arg\"); \n\
				case \"$arg\" in \n\
				..*) # relative path from git's toplevel is *outside* toplevel. No good \n\
					# No need to fix it, though. git-add will complain well enough anyway \n\
					continue; \n\
				;; \n\
				esac \n\
				if ! [ -d \"$(dirname \"$arg\")\" ]; then \n\
					mkdir -p \"$(dirname \"$arg\")\"; \n\
				fi \n\
				touch \"${arg}\"; \n\
			fi \n\
		done \n\
		git add --intent-to-add \"$@\" \n\
		} ; f"
	no-columns = !git -c column.ui=never -c column.branch=never -c column.clean=never -c column.status=never -c column.tag=never # disable columning in a further git command
	no-mailmap = !git -c mailmap.file=/dev/null -c mailmap.blob=0000000:/dev/null
	no-pager = !git --no-pager

	# promoted from my bash-implicit-git function `remote`.
	# This name was originally a typo in bash-land, but makes a good first-class citizen in git-alias-land
	# because it lets us to have a simple declaration (remote=remotes) that can be leveraged
	# by permit-aliases-to-shadow-builtins.
	# TODO: Potential naming convention for these: `remote-enhanced`, which is removed from autocomplete?
	# TODO: tab-completion isn't noticing this as a remote-variant
	remotes = "!f() { : remote; \n\
		if test \"$#\" -eq 0 || test show = \"$1\"; then \n\
			git remote -v \"$@\"; \n\
		else \n\
			git remote \"$@\" ; \n\
		fi \n\
		} ; f"
	# An alias that shadows a builtin. Not normally permitted. You must invoke it via:
	# `git permit-aliases-to-shadow-builtins remote`, (or via bash alias git='git permit-aliases-to-shadow-builtins')
	remote = remotes
	submodules = submodule # arguably a typo, but I thought this was a proper command name

	shallow = clone --depth 1
	stats = show --stat
	unshallow = fetch --unshallow
	unstash = stash pop
	untracked = status --untracked
	up = pull
	# stage = diff --staged # Fails, because stage is already a command
	staged = diff --staged
	logp = log --patch
	logs = log --stat
	logn = log --numstat

	# see pretty.jake, which is my custom formatting, defined in pretty.jake
	log-oneline = log --pretty=jake
	log-nodate  = log --pretty=jake-nodate

	rainbow = log-oneline --graph
	rainbow-here = rainbow # for legacy clarity to myself
	# NNS stores argo information in the argo_manifests branch. THAT IS NOT A REASONABLE BRANCH
	# (NB: the --exclude *must specifically* come before the --all, per git help log)
	rainbow-all = rainbow --exclude=*argo_manifests --all

	# cute aliases, inspired by https://stackoverflow.com/a/52896091/285944, sharing my common oneline alias above
	r  = rainbow-all # convenience name
	l  = rainbow
	# don't want rainbow here - stats really don't rainbow nicely
	ll = log-oneline --date=iso   --numstat
	# ld is equivalent to `rainbow --date=short`, but has different semantics.
	# This spelling prevents concidental changes to rainbow from affecting ld
	ld = log-oneline --date=short --graph
	# Prompted by the discussion on ld, this is actually the variant that *does* trust rainbow
	lr = rainbow     --date=short
	ls = log-oneline

	man = help
	# list git merges, and permit -p to turn them into patches
	# (Specifically, we don't want to FORCE patches on, but it SHOULD be *as easy as possible*)
	merges = log --merges -m

	# Abuse parameter passing - the 'yesterday' argument will pass to --since, but if we do something dumb, we'll get something dumb back.
	# (Also, we choose since-as-filter to get around weird history hiccups that things like cherry-picking can introduce)
	since = log --since-as-filter
	# TODO: it'd be *really* cool if "yesterday" implicitly meant "Friday" if today is Monday (nb: `date +%A`)
	yesterday = since yesterday
	tags = tag -l
	unstage = restore --staged

	## Utilities ("I didn't expect this to work, but I'm causing it to work anyway :D")
	# These'll more likely than not use the function tech from https://www.atlassian.com/blog/git/advanced-git-aliases
	# Also, multiline functions are strings with backslashes on the newlines. See https://stackoverflow.com/a/28502292/285944
	# (and also the `: <git-command>` completion assistance is covered in a comment there
	# I only really feel these tools to be useful if there's more than one relevant command in the function
	# TL;DR: this prevents unexpected parameters from being appended to the tail of these commands (which don't expect as many as their parent commands)
	addp-and-commitm = "!f() { git addp && git commitm \"$@\" ; } ; f"

	# re-implementing git-alias from git-extras to respect multi-line strings and use git-config subcommands
	# TODO: it would be cool to take some config --flags like --names-only
	# TODO: once I figure out the 'type expands aliases deeply' tech in bash-land, borrow it here.
	# TODO: an analog for bash's `type`, too
	alias = "!f() { \n\
		case $# in \n\
		0|1) \n\
			# NB: git config keys cannot contain shell-y characters - $match is safe unquoted here \n\
			# docs: The variable names are case-insensitive, \n\
			# allow only alphanumeric characters and -, \n\
			# and must start with an alphabetic character. \n\
			for match in $(git config list --name-only | \n\
			                   grep '^alias\\.' | \n\
			                   sed s/^alias.// | \n\
			                   grep -E \"$1\" | \n\
			                   sed s/^/alias./); do \n\
				git config get --all --show-names --null $match | \n\
					sed -E --null-data 's/^alias\\.([^\\n]+)\\n/\\1 = /g'; \n\
			done | \n\
				sort --zero-terminated | \n\
				tr '\\0' '\\n' | \n\
				git pager alias; \n\
		;; \n\
		2) \n\
			git config set --global \"$1\" \"$2\"; \n\
		;; \n\
		*) \n\
			>&2 echo \"Too many arguments\"; \n\
			cat <<-'HEREDOC'; \n\
			usage: git alias                  # list aliases \n\
			   or: git alias <regex>          # aliases with names matching a regex \n\
			   or: git alias <name> <command> # create alias \n\
			HEREDOC\n\
			# NB: HEREDOC requires no space before line termination \n\
			return 1; \n\
		;; \n\
		esac \n\
		} ; f"

	alias-grep--helper = "!f() { \n\
		git config get --all --show-names --null --regexp '^alias\\.' | \n\
			sed  -E --null-data 's/^alias\\.([^\\n]+)\\n/\\1 = /g' | \n\
			grep -E --null-data --regexp=\"$1\" | \n\
			sort --zero-terminated; \n\
		} ; f"
	alias-grep = "!f() { \n\
		if [ 1 -ne $# ]; then \n\
			>&2 echo 'git alias-grep requires exactly one argument'; \n\
			echo 'usage: git alias-grep <regex>  # aliases matching a regex, including value'; \n\
			return 1; \n\
		fi \n\
		git alias-grep--helper \"$1\" | \n\
			tr '\\0' '\\n' | \n\
			git pager alias; \n\
		} ; f"
	# NB: this is from https://stackoverflow.com/questions/14365946/create-a-branch-alias
	# and I'm not certain if it has any nasty consequences if I later want to create a proper
	# branch for main
	branch-alias = "!f() { \n\
		local newBranch existingBranch; \n\
		newBranch=${1:?need a name for the new branch}; \n\
		existingBranch=${2}; \n\
		if [ -z \"$existingBranch\" ]; then \n\
			if ! existingBranch=\"$(git current-branch 2>/dev/null)\" ; then \n\
				>&2 echo not on a current branch. Please specify a branch to alias from; \n\
				return 1; \n\
			fi \n\
		fi; \n\
		if ! git commit-ish-exists \"$existingBranch\"; then \n\
			>&2 echo \"cannot create alias $newBranch for $existingBranch - $existingBranch does not exist \"; \n\
			return 1; \n\
		elif git commit-ish-exists \"$newBranch\"; then \n\
			>&2 echo \"cannot create alias $newBranch for $existingBranch - $newBranch already exists\"; \n\
			return 1; \n\
		else \n\
			git symbolic-ref refs/heads/main refs/heads/master && \n\
			echo \"successfully aliased $newBranch for $existingBranch\"; \n\
		fi \n\
		} ; f"
	branch-alias-main-for-master = branch-alias main master

	# run an alias under tracing
	# run-alias supports GIT_TRACE, but this quick-and-dirty way *does* also grab the expansion of run-alias.
	# Meh? I think it's even a little bit useful to call out what happens *before* the alias you want to trace, too.
	alias-debug = !GIT_TRACE=1 git run-alias
	arguments-debug = "!f() { \n\
		for i; do \n\
			echo \"'$i'\"; \n\
		done ; \n\
		} ; f"
	bash-arguments-debug = "!bash -c 'f() { \n\
		for i; do \n\
			echo \"<$i>\"; \n\
		done ; \n\
		} ; f \"$@\"' bash-arguments-debug"
	# https://stackoverflow.com/questions/2363197/can-i-get-a-list-of-files-marked-assume-unchanged/2363495#2363495
	# (leveraging the function tech defined below)
	assumed-unchanged = "!f() { git ls-files -v | grep \"^[[:lower:]]\" ; } ; f"

	# NB: the git-authors command from git-extras is psychotic - it appends to any existing file with a certain name regex
	# WHICH HAPPENS TO MATCH ITS OWN SCRIPT NAME. Hence, why I'm calling it psychotic.
	authors = "!f() { git shortlog -s -e \"$@\" | awk '{$1=\"\";print}' | sort -f ; } ; f"
	authors-raw = no-mailmap authors
	# sort:
	# -t: field separator
	# -f: ignore case
	# -k: sort on k'th field
	authors-by-email = "!f() { git authors \"$@\" | sort -f -k2 -t'<' ; } ; f"

	# List files touched by a particular user, defaulting to use the current git user.name
	# (THESE FILES ARE NOT GUARANTEED TO EXIST b/c they can later be deleted)
	# see https://superuser.com/a/1792567/137598
	# The factored-out common worker. First argument is a diff-filter, second is the optional author regex
	# Neat shell-ism: there's no --diff-filter argument if 1 isn't present
	by-author = "!f() { \n\
		local authorParam diffFilterParam; \n\
		authorParam=\"--author=${1:-$(git config get user.name)}\"; \n\
		diffFilterParam=${2+--diff-filter=\"$2\"}; \n\
		# shift out up to two arguments, in a way that doesn't proc errexit. Shouldn't matter, but that's what's up \n\
		shift 2 || shift 1 || true; \n\
		git log \\\n\
				--format='' \\\n\
				--name-only \\\n\
				--no-commit-id \\\n\
				\"$authorParam\" \\\n\
				${diffFilterParam} \\\n\
				\"$@\" | \n\
			sort | \n\
			uniq; \n\
		} ; f"

	# allow the X-by-authors to essentially default-param the *second* parameter to by-author
	by-author--helper = "!f() { \n\
		case $# in \n\
		0|1) \n\
			# Abuse knowledge that authorParam is defaulted even if emptystring \n\
			git by-author '' \"$@\"; \n\
		;; \n\
		*) \n\
			# have enough arguments to swap \n\
			local filter author; \n\
			filter=$1; author=$2; \n\
			shift 2; \n\
			git by-author \"$author\" \"$filter\" \"$@\"; \n\
		;; \n\
		esac \n\
		} ; f"
	created-by-author = by-author--helper A
	deleted-by-author = by-author--helper D
	touched-by-author = by-author--helper r # Anything except a Rename
	renamed-by-author = by-author--helper R # Renames - the NEW name

	# ref: EXAMPLES section of `man git-rev-parse`
	commit-ish-exists = "!f() { \n\
		local return parsed; \n\
		git rev-parse \\\n\
				--verify \\\n\
				--end-of-options \\\n\
				\"${1?need a commit object}^{commit}\" \\\n\
				>/dev/null \\\n\
				2>&1; \n\
		return=$?; \n\
		if ! [ -t 1 ]; then \n\
			return $return; \n\
		fi \n\
		parsed=$(git rev-parse \\\n\
						--abbrev-ref \\\n\
						\"${1}\" \\\n\
						2>&1); \n\
		if [ 0 -eq $return ]; then \n\
			# parameter expansion - add (...) if parsed is not empty \n\
			echo \"${1} exists ${parsed:+(sounds like ${parsed})}\"; \n\
		else \n\
			echo $1 does not exist in git as a commitish object; \n\
		fi \n\
		return $return; \n\
		} ; f"
	# ref: https://stackoverflow.com/questions/6245570/how-do-i-get-the-current-branch-name-in-git
	# NB: git branch --show-current is less good - succeeds with empty string in detached head state
	current-branch = "!f() { git symbolic-ref --short HEAD ; } ; f"
	# Read this as "run git in a delta-like mode for this current interaction"
	# And don't confuse it with my bash alias for delta, which uses *this* to invoke git-implicitdiff
	# NB: the [delta] sections below configures the particular --features I'm using here
	# Additionally, we need to include modified settings for each custom pager in [pager]
	# TODO: that might be able to be done programatically?
	delta = !git \
			-c core.pager='delta --features=git-pager' \
			-c pager.log='LESS=\"${LESS} --lesskey-src ${HOME}/.config/lesskey-no-gotoend-on-q\" delta --features=git-pager' \
			-c interactive.diffFilter='delta --features=diff-filter' \

	env = "!f() { echo EDITOR=$EDITOR; set | git pager env; } ; f"
	gitdir = "!f() { git rev-parse --absolute-git-dir ; } ; f"
	# --local is unnecessary, but provides clarity
	ignore-untracked =  "!f() { git config set --local status.showUntrackedFiles no ; } ; f"

	remote-for-branch = "!f() { \n\
		git config get \"branch.${1:-$(git current-branch)}.remote\"; \n\
		} ; f"

	# TODO: generate a git-follow-refspec that can back-rewrite the fetch refspec to allow for actual, non-regex-modified, text comparison
	# Because this only works on normal remotes that are configured with 'remote.<name>.fetch = +refs/heads/*:refs/remotes/origin/*'
	# NB: we use `git rev-parse --symbolic-full-name @{push}` to hopefully figure out the complex dance
	# between branch.<name>.remote, remote.pushDefault, and branch.<name>.pushRemote
	# see https://stackoverflow.com/questions/2016901/how-to-list-unpushed-git-commits-local-but-not-on-origin
	is-mainline = "!f() { \n\
		( \n\
			set -o errexit; \n\
			local local remote remoteBranch remoteHead; \n\
			local=$(git current-branch); \n\
			remote=$(git remote-for-branch \"$local\"); \n\
			remoteBranch=$(git rev-parse --symbolic-full-name @{push}); \n\
			remoteHead=$(git is-mainline--find-remote-head \"${remote}\"); \n\
			echo \"Local branch $local is configured to push to $remoteBranch on $remote.\"; \n\
			echo \"The HEAD on $remote is $remoteHead.\"; \n\
			\n\
			# NB: the x-prefix is necessary in case either of these gets a dash prefix. \n\
			# Defensive coding! \n\
			[ \"x$remoteHead\" = \"x$remoteBranch\" ]; \n\
		) \n\
		} ; f"
	is-mainline-print-on-failure = "!f() { \n\
		if git is-mainline >/dev/null 2>&1; then \n\
			return; # propagates the success \n\
		fi \n\
		local ret=$?; \n\
		echo local branch $(git current-branch) is not configured to push to $(git is-mainline--find-remote-head), that remote\\'s HEAD; \n\
		return $ret; # propagate the failure \n\
		} ; f"
	# Helper - try to figure out where $remote/HEAD points, if it's not present
	is-mainline--find-remote-head = "!f() { \n\
		local remote remoteHead; \n\
		remote=${1:-$(git remote-for-branch)}; \n\
		if remoteHead=$(git rev-parse --symbolic-full-name \"${remote}/HEAD\" 2>/dev/null); then \n\
			echo $remoteHead; \n\
			return; \n\
		fi \n\
		\n\
		if ! git remote set-head \"$remote\" --auto >&2; then \n\
			>&2 echo Cannot find a remote head for $remote; \n\
			return 1; \n\
		fi \n\
		\n\
		# NB: No stderr redirection here. We do want errors to go to the user, if there are any on this retry \n\
		if remoteHead=$(git rev-parse --symbolic-full-name \"${remote}/HEAD\"); then \n\
			echo $remoteHead; \n\
			return; \n\
		else \n\
			>&2 echo Cannot determine remote head for $remote; \n\
			return 1; \n\
		fi \n\
		} ; f"


	# A variant of ls-files that lists untracked files
	# this is not the most obvious spelling, but '--other --no-ignored' doesn't actually... work
	ls-untracked = ls-files --other --exclude-standard

	# "Status, if it would have any output. Show otherwise."
	# TODO: Except there's a bug. If there's an untracked file, I'd expect status to show it. But we don't catch it here.
	status-or-show = "!f() { \n\
		if git diff --quiet && git diff --staged --quiet; then \n\
			git show \"$@\"; \n\
		else \n\
			git status \"$@\"; \n\
		fi \n\
		} ; f"

	# TODO: Let's get a "pull, but also for non-checked-out branches"

	# WARNING: this API is still experimental, so I might need to act fluidly around it
	# NOTE: categories for `list-X` are listed in https://github.com/git/git/blob/master/command-list.txt, used by https://github.com/git/git/blob/21306a098c3f174ad4c2a5cddb9069ee27a548b0/help.c#L382
	# But: Heads up! git --list-cmds=list-foreignscminterface still lists git-p4, git-cvs*, and git-svn, which aren't shipped with bare git. That's why they're in complete.commands
	# This seems to be because those commands live as dependencies of apt's git-all, and/or are present during build
	# TODO: `git is-valid-git-command --help` incorrectly reports that --help is a git command, and coincidentally prints this alias. (thanks git-help!)
	# But `git is-valid-git-command -- --help` fails, because `--` is not a command.
	# list of all list-Xs was originally generated by my own bash pipeline, but I wrote this alias to automate it
	# curl https://raw.githubusercontent.com/git/git/master/command-list.txt | awk '!/^#/{print $2}' | sort | uniq | awk '{if(a)a=a ","; a=a "list-" $0} END {print a}'
	update-completion-categories-list = "!f() { \n\
			git config set --all --global completion.list-categories \"$( \n\
				curl https://raw.githubusercontent.com/git/git/master/command-list.txt | \n\
					awk '!/^#/{print $2}' | \n\
					sort | \n\
					uniq | \n\
					awk '{ \n\
						if(a) { \n\
							a = a \" \"; \n\
						} \n\
						a = a \"list-\" $0; \n\
					} \n\
					END { \n\
						print a \n\
					}' \n\
			)\" \n\
		} ; f"

	# To wit: "Pretend there are no invalid commands, and then ask for every command that isn't invalid"
	# Detail: This effectively removes any '-dont-complete-me' entries from completion.commands, because most list-commands aliases
	#         downstream of here will replace those with the value of invalid-commands, which we just told it is empty :D
	commands--include-invalid = !git -c completion.invalid-commands=
	commands--ensure-config-last = "!f() { git \"$@\" config ; } ; f"
	# List all commands, even those that are *specifically* invalid
	list-all-commands-including-invalid = commands--include-invalid list-all-commands

	# List all the commands in all categories I'm aware of.
	# This is a specialization of list-commands, but with "as many args as we can, always"
	# You *can* call this with more parameters, but mostly, that shouldn't do anything.
	# Except nohelpers, which is a filter.
	list-all-commands = list-commands--all-categories
	list-commands--all-categories = commands--ensure-config-last list-commands--all-categories--raw
	list-commands--all-categories--raw = "!f() { \n\
			# impl. note: these config values are INTENDED to split on whitespace/contain multiple values \n\
			# NB: first arg set is LIST-categories. Second is MOST-categories \n\
			git list-commands--raw $(git config get --all completion.list-categories) \\\n\
			                       $(git config get --all completion.most-categories) \\\n\
			                       \"$@\"; \n\
		} ; f"

	# List the commands in a given set of categories that aren't *specifically* considered invalid
	# By default, this matches the list of categories in list-reasonable-commands, but minimizing the completion.commmands filtering
	# to only truly-invalid commands.
	# Otherwise, you are allowed to choose your own set of categories (except that config is always applied)
	# This is the UI wrapped around the naive helper method. It's responsible for two behaviors:
	# * always pass config at the end
	# * have a sane (non-empty) set of defaults
	#
	list-commands = "!f() { \n\
		if [ parseopt = \"$*\" ]; then \n\
		# special case - we only have one argument, and it's 'parseopt'. We do not append config because \n\
		# the --list-cmds flag rejects having parseot with other values \n\
		# Also, the output is space-separated and not newline separated. Rude. :p \n\
			git list-commands--raw \"$@\" | tr ' ' '\\n' | grep -v '^$'; \n\
		elif [ $# -gt 0 ]; then \n\
			# we're responsible for always passing config as the last entry to --list args. ...--raw isn't \n\
			git list-commands--raw \"$@\" config; \n\
		else \n\
			# $@ is unnecesary, but remains good practice \n\
			git list-commands--raw $(git config get --all completion.most-bash-completion-categories) \"$@\" config; \n\
			# Contrast to 'default to all', which is `git list-all-commands` \"$@\", and returns a few too many unreasonable elements \n\
		fi \n\
		} ; f"
	list-commands--raw = commands--include-unreasonable commands--helper

	# to wit: "Pretend that Jake's "remove all these unreasonable commands" configuration had only the barest possible value -
	# one that only excludes truly-invalid commands. Then, ask for what the reasonable commands are.
	# ... and then run some other git command
	# NB: this is effectively a !git -c <no command specified yet> alias
	commands--include-unreasonable = "!f() { \n\
			# only consider previously-found, truly-invalid commands to be removed by --list-cmds=config \n\
			# TODO: there might actually be *positive* (non-removal) elements in completion.commands... \n\
			# it would be nice to preserve those entries \n\
			git -c \"completion.commands=$(git config get completion.invalid-commands)\" \"$@\"; \n\
		} ; f"

	# take an arg-list of categories and pass them to --list-cmds formatted properly
	# Because I have configured completion.commands, this is the "most-unmodified" call to --list-cmds,
	#      upon which I can build other functions by *specifying* further behavior
	# Be aware: list-reasonable-commands *needs* to pass config as the last element, which is why we're a helper and not a full command
	commands--helper = "!f() { \n\
			# Join arg array on comma \n\
			LIST_CMDS=$(IFS=, ; echo \"$*\"); \n\
		\n\
			git --list-cmds=\"$LIST_CMDS\" | \n\
				sort | \n\
				uniq | \n\
				git pager commands; \n\
		} ; f"

	# The list of commands I consider reasonable. Until I decide better, I'm using the list of categories from
	# /usr/share/bash-completion/completions/git, which does take into account my completion.commands configuration, above.
	# For correctness's sake, config is always added at THE END, because that removes any commands I've `config`ured as 'unreasonable'
	#     in completion.commands.
	list-reasonable-commands = commands--ensure-config-last list-reasonable-commands--raw
	list-reasonable-commands--raw = "!f() { \n\
			git commands--helper \\\n\
				$(git config get --all completion.most-bash-completion-categories) \\\n\
				\"$@\"; \n\
		} ; f"

	# List the commands that aren't invalid, but are still unreasonable.
	# NB: a digression from !f() - I need bash's process substitution for this to be at all short
	list-unreasonable-commands = "!bash -c 'f() { \n\
			comm -23 <(git list-commands) \\\n\
			         <(git list-reasonable-commands) | \n\
				git pager commands; \n\
		} ; f'"
	# List the commands that aren't invalid and considered helpers
	list-helper-commands = "!bash -c 'f() { \n\
			# NB: there might be invalid helpers. I could not care less. Not worth listing them. \n\
			comm -23 <(git list-all-commands) \\\n\
					 <(git list-all-commands nohelpers) | \n\
				git pager commands; \n\
		} ; f'"

	list-commands-by-category = "!f() { \n\
		# default arguments via recursion \n\
		if [ $# -eq 0 ]; then \n\
			git list-commands-by-category \\\n\
				$( (git config get --all completion.list-categories; \n\
					git config get --all completion.most-categories) | \n\
						tr ' ' \"\\n\" | \n\
						sort | \n\
						uniq ); \n\
			return; \n\
		elif [ $# -eq 1 ]; then \n\
			# no need for all the rigamaroll \n\
			git list-commands \"$@\"; \n\
			return; \n\
		fi \n\
		\n\
		local category; \n\
		for category in \"$@\"; do \n\
			git list-commands \"$category\" | \n\
				sed \"s/^/${category} /g\"; \n\
		done | \n\
			awk ' \n\
				{ \n\
					if (a[$2]) a[$2] = a[$2] \" \"; \n\
					a[$2] = a[$2] $1; \n\
				} \n\
				END { \n\
					for (key in a) { \n\
						print key \":\", a[key]; \n\
					} \n\
				} \n\
			' | \n\
			sort; \n\
		} ; f"
	discover-invalid-commands = commands--include-invalid discover-new-invalid-commands
	discover-new-invalid-commands = "!f() { \n\
			local i; \n\
			# NB: word splitting and the rules for git commands mean I don't fear not-quoting $i here \n\
			# NB: helpers should always be considered valid. Also - they don't respond to these queries well. :shrug: \n\
			for i in $(git list-all-commands nohelpers); do \n\
				if ! git potentially-valid-git-command $i >/dev/null 2>&1; then \n\
					echo $i # found an invalid command! \n\
				fi \n\
			done \n\
		} ; f"

	update-invalid-commands = "!f() { \n\
			candidates=\"$(git discover-invalid-commands | sed 's/^/-/g' | tee /dev/stderr | tr \"\\n\" ' ')\"; \n\
			git config set --global completion.invalid-commands \"$candidates\"; \n\
		} ; f"
	update-new-invalid-commands = "!f() { \n\
			candidates=\"$(git discover-new-invalid-commands | sed 's/^/-/g' | tee /dev/stderr | tr \"\\n\" ' ')\"; \n\
			candidates=\"$(git config get completion.invalid-commands) $candidates\"; \n\
			git config set --global completion.invalid-commands \\\n\
				\"${candidates% }\"; \n\
		} ; f"

	potentially-valid-git-command = "!f() { \n\
			git help \"$1\" || \n\
			git \"$1\" --help 2>&1 | grep -s -q --line-regexp \"No manual entry for git-${1}\"; \n\
		} ; f"
	# TODO: remove '-git' from here. But later, after coordination with users of it
	is-valid-git-command = "!f() { \n\
		git list-all-commands | \n\
			grep -q -s \\\n\
				--line-regexp \\\n\
				--fixed-strings \\\n\
				-- \\\n\
				\"${1?Need a value}\"; \n\
		} ; f"
	# --local is unnecessary, but provides clarity
	silence-mr-pull = "!f() { git config set --local merge.stat no ; } ; f"
	ouroboros = "!f() { git remote add ouroboros \"$(git rev-parse --absolute-git-dir)\" ; } ; f"
	# named from https://stackoverflow.com/questions/16163829/git-get-effective-git-dir-if-current-dir-is-a-working-tree-subdir-and-git-dir
	# NB: git-extras has git-root, which is essentially rev-parse --show-toplevel
	show-git-dir = rev-parse --git-dir
	unpaged = no-pager

	# TODO: use --default in git config get here.
	pager = "!f() { \n\
			if ! [ -t 1 ]; then \n\
				# stdout is not terminal \n\
				cat; \n\
				return; \n\
			fi \n\
			if [ -z \"$1\" ]; then \n\
				>&2 echo 'please specify a subcommand. Using pager as command name'; \n\
			fi \n\
			local pager; \n\
			if [ -n ${GIT_PAGER+git-pager-has-a-set-value-including-the-empty-string} ]; then \n\
				# GIT_PAGER is set to something. But remember: '' means 'cat' \n\
				pager=${GIT_PAGER:-cat}; \n\
			elif pager=$(git config get \"pager.${1:-pager}\"); then \n\
				# TODO: case insensitivity \n\
				case \"$pager\" in \n\
					no|off|false|0|'') \n\
						echo disabled pager; \n\
						cat; \n\
						return; \n\
					;; \n\
					yes|on|true|1) \n\
						pager=\"$(git var GIT_PAGER)\"; \n\
						return; \n\
					;; \n\
				esac \n\
			else \n\
				pager=\"$(git var GIT_PAGER)\"; \n\
			fi \n\
			eval \"$pager\"; \n\
		} ; f"

	# git config, but with no way to access local or worktree configs.
	# This leaves only the 'protected configurations' from `git help config`
	# From the docs:
	#   *  Protected configuration refers to the system, global, and command scopes.
	#   * [all SCOPES  are: system, global, local, worktree, and command]
	# So, to get protected configurations, we disregard the local and worktree scopes...
	#     and implicitly the -c/command scopes
	# We do that by ensuring git cannot read any local GIT_DIR stuff.
	# BUT!!!!!!!!
	# BEWARE!!!!!!
	# LOCAL CONFIGS CAN OVERRIDE THIS ALIAS ITSELF!!!!!!!!!
	protected-config = "!f() { \n\
		# This *should* be the most you-can't-read-this-folder folder name possible. \n\
		# No files are allowed to have the null byte (otherwise find -print0 would be useless) \n\
		# And I want it as short as possible, while still being self-documenting \n\
		# printf -v NOT_A_FOLDER '%s\\0' disabled - not a folder \n\
		local NOT_A_FOLDER=\"$(printf '%s\\0' disabled - not a folder)\"; \n\
		NOT_A_FOLDER=\"/$NOT_A_FOLDER\"; \n\
		GIT_DIR=\"$NOT_A_FOLDER\" GIT_COMMON_DIR=\"$NOT_A_FOLDER\" git config \"$@\"; \n\
		} ; f"

	# see handle_alias in git's git.c
	# Heads up - this is not 'infectious' - only the most-immediate command is allowed to shadow builtins.
	# To wit: you can shadow `ls-files = ls-files --default-arguments...` and not produce an infinite loop
	# Nor will `commit=push; push=commit`. Running `git permit... commit` simply means push, and vice-versa
	# The git commands you run in *any* alias do not automatically have the permit-... tech applied
	# You. Must. Opt. In.
	permit-aliases-to-shadow-builtins = "!f() { \n\
		local aliasName=${1?need an alias to expand}; \n\
		if git protected-config \\\n\
				get \\\n\
				--all \\\n\
				--value=\"$aliasName\" \\\n\
				--fixed-value \\\n\
				safe.aliases.alias \\\n\
				>/dev/null \\\n\
				2>&1; then \n\
			git run-alias \"$@\"; \n\
			return \n\
		fi \n\
		if git protected-config \\\n\
				get \\\n\
				--all \\\n\
				\"alias.$aliasName\" \\\n\
				>/dev/null \\\n\
				2>&1 && \n\
			git list-commands builtins | \n\
				grep --line-regexp --fixed-string \"$aliasName\" \\\n\
				>/dev/null \\\n\
				2>&1 && \n\
			[ true = $(git config \\\n\
						get \\\n\
						--type=bool \\\n\
						--default=true \\\n\
						advice.aliasShadowingBuiltinNotOnWhitelist) ]; then \n\
			# NB: if aliasName matches a git command, especially a builtin one? It's safe to leave unquoted here \n\
			trap \" \n\
					echo \n\
					echo '=========== CAUTION! permit-aliases-to-shadow-builtins ============'; \n\
					echo 'A non-whitelisted alias exists for' $aliasName; \n\
					echo 'Consider deleting it or adding it to safe.aliases.alias'; \n\
					echo 'via: git config unset --global --all' alias.$aliasName; \n\
					echo ' or: git config set --global --append safe.aliases.alias' $aliasName; \n\
					echo ' or Disable this message with:'; \n\
					echo '   git config set --global advice.aliasShadowingBuiltinNotOnWhitelist false'; \n\
					echo '=========== CAUTION! permit-aliases-to-shadow-builtins ============'; \n\
					echo \n\
				\" EXIT; \n\
		fi \n\
		\n\
		git \"$@\"; \n\
		} ; f"

	# NB: this WILL conflate aliasing of `a=b` and `a=!git b`. I'm not certain I have a problem with that.
	alias--as-sh-able = "!f() { \n\
		# A string not starting with ! gets 'git ' prepended \n\
		# A prefix ! is removed \n\
		git protected-config get --null \"alias.${1?need an alias to expand}\" | \n\
			sed --null-data \\\n\
				-e 's/^[^!]/git &/' \\\n\
				-e 's/^!//'; \n\
		} ; f"

	# Runs any alias, including those that shadow builtins.
	# THERE IS NO CHECKING ON THIS. You asked for this behavior by invoking this command.
	# If you want to be safer, check out permit-aliases-to-shadow-builtins
	run-alias = "!f() { \n\
		local aliasName alias; \n\
		aliasName=${1?need an alias to expand}; \n\
		alias=$(git alias--as-sh-able \"$aliasName\"); \n\
		# move the alias name out of $@ \n\
		shift; \n\
		case \"$alias\" in \n\
		git*) \n\
			# A within-git alias. Let string expansion apply. \n\
			# alias--as-sh-able already prepended git \n\
			$alias \"$@\"; \n\
			return; \n\
		;; \n\
		esac \n\
		if [ $# -gt 0 ]; then \n\
			# prepare_shell_cmd puts $@ into the shell command if there are more args \n\
			alias=$(printf '%s \"$@\"' \"$alias\"); \n\
		fi \n\
		local sh_args command_name=\"run-alias $aliasName\"; \n\
		# handle redirection to low-ish FDs or files. Enabling -x happens below. \n\
		case \"${GIT_TRACE}\" in \n\
			[3-9]) \n\
				exec 2>&${GIT_TRACE}; \n\
			;; \n\
			/*) \n\
				# NB: >> to append, not clobber, as the invoking git is probably also writing \n\
				exec 2>>${GIT_TRACE}; \n\
			;; \n\
		esac \n\
		# TODO: this might be the best 'just get the lower case of the argument once' I can do \n\
		# in bash, this line is just spelled `case \"${GIT_TRACE,,}\" in` \n\
		case \"$(GIT_TRACE=\"$GIT_TRACE\" bash -c 'echo \"${GIT_TRACE,,}\"')\" in \n\
		[1-9]|true|/*) \n\
				echo 'GIT_TRACE is enabled - turning on alias debugging'; \n\
				echo 'sh -x output will appear on stderr'; \n\
				sh_args='-x'; \n\
				command_name=$alias; \n\
			;; \n\
		esac \n\
		sh $sh_args -c \"$alias \" \"$command_name\" \"$@\"; \n\
		} ; f"

	# Stolen from mr's git_status action, and modified for my purposes
	# TODO: --simplify-by-decoration is a good "trim the tree to relevant bits" flag. Potentially use it in more places
	# TODO: I'd also like the upstream mr-status to list commits from local branches that aren't pushed to their tracked branches
	# WARNING: this *is not* respected by mr, unless you configure `git_status = git mr-status "$@"` AND ALL OTHER TYPES!!!
	# (that's at least vcsh, git_fake_bare, and git_bare)
	mr-status = "!f() { \n\
			git status -s \"$@\"; \n\
			git --no-pager log --branches --not --remotes --simplify-by-decoration --decorate --oneline; \n\
			# git --no-pager log --simplify-by-decoration --decorate --oneline @{upstream}.. --; \n\
			git --no-pager stash list; \n\
			git is-mainline-print-on-failure; \n\
		} ; f"

	# Migrated from junk drawer - "pull, but reshallow"
	# TODO: why does this output "(forced update)"? Is --depth 1 implying a forcing? (probably)
	# The pull command doesn't fully complete on its own, but a retry succeeds :/
	# Pulling the fetch out first seems to succeed, but isn't intuitive
	# (I'm still doing it so I can have this script work better)
	pull-shallow = "!f() { \n\
		git fetch --no-tags --depth 1 \"$@\" && \n\
			(git diff --stat HEAD origin/HEAD || echo 'failure in diff --stat') && \n\
			git pull --no-tags --rebase --depth 1 --quiet \"$@\"; \n\
		} ; f"

	# TODO: also need to expire the reflog with git reflog expire --expire=all --all, per https://stackoverflow.com/a/62650346/285944
	# TODO: also might need to repack, per a peer answer: https://stackoverflow.com/a/53245223/285944
	# In fact, it might be nice to 'stash' two files - one for the tags and one for the reflog so they can be restored
	# Alternatively, following github's "Here are your local changes. Please type the name of this repo to proceed" prompt might be cool, too
	# I should also do something along the lines of "create a shallow (--depth=1) clone; compare its .git dir's size"
	reshallow = "!f() { \n\
			echo 'deleting tags:'; \n\
			git show-ref --tags; \n\
			git tag -d $(git tag -l); \n\
			git pull --rebase --no-tags --depth 1; \n\
			git gc --prune=all; \n\
		} ; f"
	# TODO: in progress
	alias-lib-dir = "!f() { echo \"${GIT_ALIAS_LIB_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/git/alias-lib.d}\"; } ; f"
	extract-aliases-to-library = "!f() { \n\
		local candidate candidates libDir; \n\
		candidates=$(git alias-grep--helper \" = !\" | \n\
			sed --null-data 's/ .*//' | \n\
			tr '\\0' '\\n' | \n\
			cat); \n\
		echo $candidates; \n\
		libDir=\"$(git alias-lib-dir)\"; \n\
		mkdir -p \"$libDir\"; \n\
		for candidate in $candidates; do \n\
			echo progress: $candidate; \n\
			git alias--as-sh-able $candidate | \n\
			sed \"s/^f()/${candidate}()/\" | \n\
			sed \"s/^bash -c 'f()/${candidate}()/\" | \n\
			sed -E \"s/} ;\\s+f\\b.*$/}/\" | \n\
			sed -E 's/\\) \\{(.*})/) {\\n\\1/g' | \n\
			cat >\"${libDir}/${candidate}\"; \n\
			shfmt -w \"${libDir}/${candidate}\"; \n\
		done; \n\
		} ; f"
	# Style: We could drop the f(){} pretense here, but it makes it easier to export to bash
	run-library-alias = "!bash -c 'f() { \n\
			local alias=${1?need an alias}; \n\
			source \"$(git alias-lib-dir)/$alias\"; \n\
			\"$alias\" \"$@\"; \n\
		} ; f \"$@\"' run-library-alias"

[fetch]
	all = true   # Fetch should assume --all. Thank you git 2.44 :D. Oh. This is all 'remotes', not all 'branches'. Boo.
	parallel = 0 # zero means "some reasonable (non-1) default"; the default value is 1
[checkout]
	defaultRemote = origin
[init]
	defaultBranch = main
[lfs]
	locksverify = false
[push]
	autoSetupRemote = true
[help]
	autoCorrect = prompt
[core]
	# almost every paged output that I care about is going to prefix the tabbed output with a +/-/' ' character
	# at a minimum that's: logp, show, diff
	# this shifts my normal --tabs=2 over by that one character
	pager = less --tabs=3,5
[pager]
	# The --lesskey-src file is mostly empty, but re-overrwrites the q command in less to just quit (and not scroll to the end beforehand,
	# which is an enhanced behavior that I ususally enjoy)
	# The -O argument asks less to flush its stdin paged output to the given file. This is a second way I'm experiementing about
	# preventing SIGPIPE errors in git when less 'exits suddenly' on q, and therefore 'doesn't properly consume all the git log output'
	# (The other is simply having my ~/bin/git wrapper take the sigpipe error code and... just turn it into a success)
	# NB: -O overwrites automatically. None of -o, --log-file, nor --LOG-FILE do.
	# NB: I have removed -O /dev/null - it takes 11s to `LESS+=+Q logp` in the maven repo. 0.07s when -O is removed
	log = less --lesskey-src ~/.config/lesskey-no-gotoend-on-q
	status = true # `git status` should always use a pager
	show-branch = true # ditto
	help = true
	# Read and used by my git-pager alias:
	# TODO: it would be nice if this bat coloring respected color.alias too, somehow. (See git config --get-colorbool)
	alias = bat --style=plain --language=bash
	# WARNING: adding custom pagers here goozles the delta alias. Adding a custom entry here should add one there
[column]
	ui = auto
[diff]
	context = 5
	tool = vimdiff
	mnemonicPrefix = true
	colorMoved = default # Currently means 'zebra', which uses blue/purple for moved lines. Very pretty :)
[delta]
	# Leverage delta features to get cool behaviors. Our default-feature sets tabs to 4. That means
	# that I'll get that whenever I invoke the delta executable directly.
	# But that gets overwritten when we're using 'delta.exe' in our 'git-delta' alias because those commands
	# specifically specify those --features.
	# When that happens, the git-delta pagers end up using natural tabs instead of configured-width tabs
	features = default-feature
	tabs = 0 # print tabs naturally - respect `tabs` setting in the terminal
[delta "default-feature"]
	tabs = 4
[delta "diff-filter"]
	color-only = true
[delta "git-pager"]
	max-line-length = 0 # Don't wrap lines
[blame]
	date = human-local
[submodule]
	# Allow submodule recursion everywhere. This gets thorny with mr fetching bat's 85(!) submodules,
	# but it's really useful where I want it to be, and as long as I put out that fire
	recurse = true
[pretty]
	# Impl. notes:
	# This used to be part of a raw --pretty invocation (from the stackoverflow link for the l,ll,ls alias variants)
	# but it is sooo much cleaner here!
	# This will almost always be paired with --date=human-local from log.date, below
	# I use an explicit tformat, instead of the implicit one you get by setting --pretty with a %-substitution
	# I use tformat over format, because I like the terminator semantics over the separator syntax
	# (I want the final newline, and since I'm making a oneline-like format, I benefit from
	#    "This means that the final entry of a single-line format will  be properly terminated
	#     with a new line, just as the "oneline" format does")
	# %h: abbreviated commit hash. Auto-colors with color.diff.commit
	# %ad: author date, respecting --date=..., and log.date (log.date is set to human-local)
	# %d: decorations. Auto-colors with color.decorate.*, and color.diff.commmit for the parens, commas, etc.
	# %s: commit subject
	# %aN: author name, respecting mailmap
	# TODO: It'd be really cool to get a field which can be empty which is approximately
	#       "committer name, but blank if it is identical to the author", so we could leverage
	#       these behaviors from git-log's man page:
	#  If you add a + (plus sign) after % of a placeholder, a line-feed is inserted immediately before the expansion if and only if the placeholder expands to a non-empty string.
	#  If you add a - (minus sign) after % of a placeholder, all consecutive line-feeds immediately preceding the expansion are deleted if and only if the placeholder expands to an empty string.
	#  If you add a ` ` (space) after % of a placeholder, a space is inserted immediately before the expansion if and only if the placeholder expands to a non-empty string.
	jake = tformat:%C(auto)%h %C(green)%ad%C(auto)%d %C(reset)%s %C(blue)[%aN]
	# Abuse empty string concatenation to get these to line up even though I drop stuff out of it
	jake-nodate = tformat:%C(auto)%h""""""""""""""%d %C(reset)%s %C(blue)[%cN]
[log]
	# ask git log to act as if --follow is always present
	follow = true
	# get relative dates when it's short, otherwise good dates anyway
	# TODO: I added auto: here, because the docs imply that this means "use human-local, unless the pager is not in use"
	# ... that seems right, but I dunno
	date = auto:human-local
	# --diff-merges=on should behave like --diff-merges=first-parent. show -m, too.
	# This especially helps the git-merges alias above to simply have -m and get these first-parent diffs
	diffMerges = first-parent
[commit]
	verbose = true


