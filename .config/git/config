[user]
	name = Jake Boeckerman
	email = jakebman@gmail.com
[alias]
	co = checkout
	dif = diff
	idff = diff
	comit = commit
	comm0t = commit
	comm9t = commit
	comm-t = commit
	commt = commit
	statu = status
	tatus = status
	stashs = stash
	ignored = status --ignored
	untracked = status --untracked
	tpush = push
	tgui = gui
	idiff = implicitdiff
	# https://stackoverflow.com/questions/2363197/can-i-get-a-list-of-files-marked-assume-unchanged/2363495#2363495
	# (leveraging the function tech defined below)
	assumed-unchanged = "!f() { git ls-files -v | grep \"^[[:lower:]]\" ; } ; f"
	up = pull
	staged = diff --staged
	# see also git-alias in git-extras
	aliases = "!f() { git config --get-regexp '^alias\\.' | sed 's/^alias\\./alias: /g' | sort | less ; echo also check out git-alias in git-extras ; } ; f"
	alises = aliases
	logp = log --patch
	logs = log --stat
	logn = log --numstat
	dff = diff
	jstg = j --staged
	jdf = j --diff
	jmg = j --merge
	jws = j --ws
	ocmmit = commit
	tags = tag -l
	# function tech to ensure no parameters get sent to set. See https://www.atlassian.com/blog/git/advanced-git-aliases
	# TODO: /usr/share/bash-completion/completions has smarts about using the null command for completion that I don't understand
	env = "!f() { echo EDITOR=$EDITOR; set ; } ; f"
	authors-l = authors -l # renamed because git-extras has an authors command
	authors-raw = -c mailmap.file=/dev/null -c mailmap.blob=0000000:/dev/null authors-l
	authors-by-email = "!f() { git authors-l \"$@\" | sort -f -k2 -t'<' ; } ; f"
	rainbow = log-oneline --graph --all

	# see pretty.jake, which is my custom formatting, defined in pretty.jake
	log-oneline = log --pretty=jake
	log-nodate  = log --pretty=jake-nodate
	# cute aliases, modified from https://stackoverflow.com/a/52896091/285944 to share my common oneline alias above
	l  = log-oneline
	ll = log-oneline --date=iso   --numstat
	ld = log-oneline --date=short --graph
	ls = log-oneline
	unstage = restore --staged
	pus = push
	ad = add
	addp = add -p
	delta = !git -c core.pager='delta --max-line-length 0' -c interactive.diffFilter='delta --color-only'
	deltaDiff = delta diff
	deltaAdd = delta add --patch # --patch is implied if you're adding with delta
	deltaLog = delta log --patch # --patch is implied if you're going to send log to delta
	man = help
	autostash = pull --rebase --autostash
	# stage = diff --staged # Fails, because stage is already a command
	config-debug = config --list --show-origin --show-scope
	# named from https://stackoverflow.com/questions/16163829/git-get-effective-git-dir-if-current-dir-is-a-working-tree-subdir-and-git-dir
	show-git-dir = rev-parse --git-dir
[fetch]
	# Fetch should assume --all
	# This config (will be) added in git 2.44
	all = true
[checkout]
	defaultRemote = origin
[init]
	defaultBranch = main
[lfs]
	locksverify = false
[push]
	autoSetupRemote = true
[help]
	autoCorrect = prompt
[pager]
	status = true # `git status` should always use a pager
[diff]
	context = 5
	tool = vimdiff
	mnemonicPrefix = true
	colorMoved = default # uses blue/purple for moved lines. Very pretty :)
[blame]
	date = human-local
[mailmap]
	# TODO: I wish there were a way to read this value from the environment,
	# because this is truly/more-logically "${XDG_CONFIG_HOME:-${HOME}/.config}/git/mailmap"
	file = ~/.config/git/mailmap
[submodule]
	# Allow submodule recursion everywhere. This gets thorny with mr fetching bat's 85(!) submodules,
	# but it's really useful where I want it to be, and as long as I put out that fire
	recurse = true
[pretty]
	# Impl. notes:
	# This used to be a raw --pretty invocation (from the stackoverflow link for the l,ll,ls alias variants)
	# but it is sooo much cleaner here!
	# This will almost always be paired with --date=human-local from log.date, below
	# I use an explicit tformat, instead of the implicit one you get by setting --pretty with a %-substitution
	# I use tformat over format, because I like the terminator semantics over the separator syntax
	# (I want the final newline, and since I'm making a oneline-like format, I benefit from
	#    "This means that the final entry of a single-line format will  be properly terminated
	#     with a new line, just as the "oneline" format does")
	# %h: abbreviated commit hash. Auto-colors with color.diff.commit
	# %ad: author date, respecting --date=..., and log.date (log.date is set to human-local)
	# %d: decorations. Auto-colors with color.decorate.*, and color.diff.commmit for the parens, commas, etc.
	# %s: commit subject
	# %aN: author name, respecting mailmap
	# TODO: It'd be really cool to get a field which can be empty which is approximately
	#       "committer name, but blank if it is identical to the author", so we could leverage
	#       these behaviors from git-log's man page:
	#  If you add a + (plus sign) after % of a placeholder, a line-feed is inserted immediately before the expansion if and only if the placeholder expands to a non-empty string.
	#  If you add a - (minus sign) after % of a placeholder, all consecutive line-feeds immediately preceding the expansion are deleted if and only if the placeholder expands to an empty string.
	#  If you add a ` ` (space) after % of a placeholder, a space is inserted immediately before the expansion if and only if the placeholder expands to a non-empty string.
	jake = tformat:%C(auto)%h %C(green)%ad%C(auto)%d %C(reset)%s %C(blue)[%aN]
	# Abuse empty string concatenation to get these to line up even though I drop stuff out of it
	jake-nodate = tformat:%C(auto)%h""""""""""""""%d %C(reset)%s %C(blue)[%cN]
[log]
	# ask git log to act as if --follow is always present
	follow = true
	# get relative dates when it's short, otherwise good dates anyway
	date = human-local
[commit]
	verbose = true
[safe]
	# I intend safe.directory to be read:
	# * by WSL's /usr/bin/git
	# * from Window's %USERHOME%/.gitconfig
	# * * through the received GIT_CONFIG_GLOBAL="${WSL_WINDOWS_USER_HOME:?}/.gitconfig")
	# * when my ~/bin/git redirection thinks that WSL's git can be faster than Windows' git.exe
	# So:
	# * These directory names need to be valid *from WSL's perspective*
	# But:
	# * These entries will only ever be read *from Windows's config files*
	# But Anyway:
	# * It's probably just easier to let this situation trust all directories
	# So:
	# ... just change the value of this to `directory = *` in the Windows config
	# But Still:
	# * I can't in good conscience commit this with `directory = *` into my dotfiles repo
	# So:
	# * It's just going to be some example folders from work
	directory = /mnt/c/Users/P2776931/Projects/restserver
	directory = /mnt/c/Users/P2776931/Projects/nationalnavigation
