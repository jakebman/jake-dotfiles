# look for the ~/.netrc file, which can have baked-in usernames and passwords
--netrc-optional
# --dump-header /home/jakebman/curlheaders.txt # handled differently - I have a bash function wrapping curl for this

--location
# TODO: consider --post30x flags here, too

# Store cookies here. NB: this fails silently if the file isn't found :(. Use -v to hear if it fails
--cookie-jar /home/jakebman/.cache/curl/cookie-jar

# progress meter is annoying and I need it out of my way
--no-progress-meter
