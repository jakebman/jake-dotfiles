<settingsSecurity>

  <!--
    Generate the linked file via: (-emp is short for {dash-dash isn't allowed in XML comments}encrypt-master-password)

      echo "<settingsSecurity><master>$(mvn -emp "$(passgen)")</master></settingsSecurity>" | xml > /home/jakebman/.m2/settings-security-generated.xml

    Then you generate encrypted passwords via: (again: {dash-dash}encrypt-password)

      mvn -ep  your-password

    Read more at:
    https://stackoverflow.com/questions/51503336/generate-settings-security-xml-file-for-maven-password-encryption
    https://maven.apache.org/guides/mini/guide-encryption.html
  -->
    <relocation>/home/jakebman/.m2/settings-security-generated.xml</relocation>
</settingsSecurity>
