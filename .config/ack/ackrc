
# files are lexicographically sorted (consistent between runs)
--sort-files

# Ignore case if the argument is entirely lowercase:
--smart-case

# I really like paged output
# TODO: it would be *really cool* if ack --passthru also automatically told less the search regex
--pager=less --lesskey-src ~/.config/lesskey-no-gotoend-on-q

# some files I know ack can ignore
## Java
--ignore-directory=is:target
--ignore-directory=is:.idea
--ignore-file=is:.flattened-pom.xml
--ignore-file=ext:class
--ignore-file=ext:jar
## Node
--ignore-directory=is:node_modules
--ignore-directory=is:.npm
## Python
--ignore-directory=is:.venv
## GNU gettext portable object files - i.e. translations
--ignore-file=ext:po
## PEM certificates:
--ignore-file=ext:crt
--ignore-file=ext:pem

# My Own Types

## Clang - C language files
### I couldn't remember that C files were under the name CC. I tried clang first.
### So now THAT WORKS!
--type-add=clang:ext:c,h,xs
## Header - C and C++ header files
### Also, (c-only) header files are named hh. That's obscure too. Here's a copy of hpp
--type-add=header:ext:hpp,hh,h,hxx

## Bash - a section of the shell type, but bash/sh only
--type-add=bash:ext:sh,bash #,csh,tcsh,ksh,zsh,fish
--type-add=bash:firstlinematch:/^#!.*\b(?:ba)?sh\b/

## Jakely-named files. 99% of the time, these are files I created
--type-add=jake:match:/(?i:jake)/
### a typo:
--type-add=hake:match:/(?i:jake)/

## Foo-ly named files - foo.txt, asdf.foo, etc.
--type-add=foo:match:/\b(?i:foo)\b/

## --yaml exists, but sometimes I call it --yml
--type-add=yml:ext:yaml,yml
## Bash-it
--type-add=alias:match:/\.alias\.bash$/
--type-add=plugin:match:/\.plugin\.bash$/
--type-add=completion:match:/\.completion\.bash$/
--type-add=theme:match:/\.theme\.bash$/

## Maven
--type-add=pom:is:pom.xml
--type-add=pom:ext:pom

--type-add=mvn:is:pom.xml
--type-add=mvn:ext:pom

--type-add=maven:is:pom.xml
--type-add=maven:ext:pom

## Text files
### I apparently need two names for this, because typing that e is apparently arduous
--type-add=txt:ext:txt
--type-add=text:ext:txt

## Readme files
--type-add=readme:ext:txt
--type-add=readme:ext:md
--type-add=readme:ext:rst
--type-add=readme:ext:adoc
--type-add=readme:match:/\b(?i:readme)\b/

## Asciidoc files
### I don't know which name I'd use, so let's scattershot this
--type-add=asciidoc:ext:adoc
--type-add=adoc:ext:adoc

## Docker files
--type-add=docker:is:Dockerfile
--type-add=docker:ext:dockerfile
--type-add=docker:match:dockerfile*

## Continuous integration files
--type-add=ci:is:.gitlab-ci.yml
### TODO: more ci files

## Markdown files, or similar. Mostly the same as readme
--type-add=md:ext:md

## Cucumber (test) files
--type-add=cucumber:ext:feature
--type-add=cucumber:ext:story

--type-add=feature:ext:feature
--type-add=story:ext:story

## ALLCAPS files (README, LICENSE, CONTRIBUTING, AUTHORS, etc.)
--type-add=caps:match:/^[A-Z_]+$/
--type-add=CAPS:match:/^[A-Z_]+$/

## Google Protobuf
--type-add=proto:ext:proto

## RPM .spec files
--type-add=spec:ext:spec

## Oauth files. Mostly, these are the work files `oauthsecret<place>` and similar
--type-add=oauth:match:/oauth/

## Properties files
--type-add=properties:ext:properties
### (These are special .properties.template files from NNS, but I don't mind keeping it for my person)
--type-add=properties:match:/\.properties\..*/

## Config figles. Ack is nice and also accepts the unambiguous prefix --conf/--no-conf
--type-add=config:ext:config
--type-add=config:ext:conf
# TODO: do .ini files count? Should --no-config try and remove *all* config files, or just .config files?

## MR (myrepos) config files
--type-add=mrconfig:is:.mrconfig

## Git files
### The config, ignore, etc. files live in $XDG_CONFIG_HOME/git
--type-add=git:match:.?(git)?config
--type-add=git:match:.?(git)?ignore

## Gitignore files
--type-add=gitignore:is:.gitignore

## GNU gettext message catalogue
### I found these first in git's source tree
### I'm unconditionally excluding them above, but let's still keep an entry for them here
### in case I change my mind later
--type-add=po:ext:po

## Jenkins files
### NNS uses several variants on the actual jenkinsfile names.
### Honestly, at this point, this should just be a case-insensitive
### match on the word 'jenkins'
--type-add=jenkins:is:Jenkinsfile
--type-add=jenkins:is:JenkinsFile
--type-add=jenkins:match:jenkinsfile
--type-add=jenkins:match:.*-JenkinsFile
