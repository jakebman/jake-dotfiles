
# files are lexicographically sorted (consistent between runs)
--sort-files

# Ignore case if the argument is entirely lowercase:
--smart-case

# I really like paged output
--pager=less

# some files I know ack can ignore
## Java
--ignore-directory=is:target
--ignore-directory=is:.idea
--ignore-file=ext:class
--ignore-file=ext:jar
## Node
--ignore-directory=is:node_modules
--ignore-directory=is:.npm
## Python
--ignore-directory=is:.venv

# My Own Types

## Clang - C language files
### I couldn't remember that C files were under the name CC. I tried clang first.
### So now THAT WORKS!
--type-add=clang:ext:c,h,xs
## Header - C and C++ header files
### Also, (c-only) header files are named hh. That's obscure too. Here's a copy of hpp
--type-add=header:ext:hpp,hh,h,hxx

## Bash - a section of the shell type, but bash/sh only
--type-add=bash:ext:sh,bash #,csh,tcsh,ksh,zsh,fish
--type-add=bash:firstlinematch:/^#!.*\b(?:ba)?sh\b/

## Jakely-named files. 99% of the time, these are files I created
--type-set=jake:match:/(?i:jake)/
### a typo:
--type-set=hake:match:/(?i:jake)/

## Foo-ly named files - foo.txt, asdf.foo, etc.
--type-set=foo:match:/\b(?i:foo)\b/

## Bash-it
--type-set=alias:match:/\.alias\.bash$/
--type-set=plugin:match:/\.plugin\.bash$/
--type-set=completion:match:/\.completion\.bash$/
--type-set=theme:match:/\.theme\.bash$/

## Maven
--type-set=pom:is:pom.xml
--type-add=pom:ext:pom

--type-set=mvn:is:pom.xml
--type-add=mvn:ext:pom

--type-set=maven:is:pom.xml
--type-add=maven:ext:pom

## Text files
### I apparently need two names for this, because typing that e is apparently arduous
--type-set=txt:ext:txt
--type-set=text:ext:txt

## Readme files
--type-set=readme:ext:txt
--type-add=readme:ext:md
--type-add=readme:ext:rst
--type-add=readme:ext:adoc
--type-add=readme:match:/\b(?i:readme)\b/

## Docker files
--type-set=readme:is:Dockerfile

## Continuous integration files
--type-set=ci:is:.gitlab-ci.yml

## Markdown files, or similar. Mostly the same as readme
--type-add=md:ext:md

## ALLCAPS files (README, LICENSE, CONTRIBUTING, AUTHORS, etc.)
--type-set=caps:match:/^[A-Z_]+$/
--type-set=CAPS:match:/^[A-Z_]+$/

## Google Protobuf
--type-add=proto:ext:proto

## Properties files
--type-add=properties:ext:properties
### (These are special .properties.template files from NNS, but I don't mind keeping it for my person)
--type-add=properties:match:/\.properties\..*/

## Gitignore files
--type-add=gitignore:is:.gitignore

## Jenkins files
### NNS uses several variants on the actual jenkinsfile names.
### Honestly, at this point, this should just be a case-insensitive
### match on the word 'jenkins'
--type-set=jenkins:is:Jenkinsfile
--type-add=jenkins:is:JenkinsFile
--type-add=jenkins:match:jenkinsfile.*
--type-add=jenkins:match:.*-JenkinsFile
