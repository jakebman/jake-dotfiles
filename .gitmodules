[submodule "editorconfig-vim"]
	path = .vim/pack/editorconfig/start/editorconfig-vim
	url = git@github.com:editorconfig/editorconfig-vim.git
	branch = master
	# use a non-detached HEAD strategy in the submodule
	update = rebase
[submodule "bin/gitstatus"]
	path = bin/gitstatus
	url = git@github.com:romkatv/gitstatus.git
	branch = master
	# use a non-detached HEAD strategy in the submodule
	update = rebase
[submodule ".vim/pack/obsession/start/obsession"]
	path = .vim/pack/obsession/start/obsession
	url = git@github.com:tpope/vim-obsession.git
	branch = master
	# use a non-detached HEAD strategy in the submodule
	update = rebase
[submodule ".vim/pack/vim-polyglot/start/vim-polyglot"]
	path = .vim/pack/vim-polyglot/start/vim-polyglot
	url = https://github.com/sheerun/vim-polyglot
	branch = master
	# use a non-detached HEAD strategy in the submodule
	update = rebase
