# EditorConfig is awesome: http://EditorConfig.org

# this is the top-level config. You can stop looking
root = true

# Reasonable defaults
[*]
indent_size = 2
indent_style = space
end_of_line = lf
charset = utf-8

trim_trailing_whitespace = true
insert_final_newline = true

# My ~/bin files should be considered shell files, unless a rule below overrides it
# Currently, that's just the .py rule
[{bin/*,**.*sh,test/run,**.bats}]
# Setting indent_size to 'tab' is probably less-well-defined than other settings, but it probably means 'platform tab size'
# The documentation for editorconfig is a little silent on what this will actually do
indent_size = tab
indent_style = tab

shell_variant      = bash
binary_next_line   = true  # like -bn
switch_case_indent = true  # like -ci
space_redirects    = true  # like -sr
keep_padding       = false # like -kp
end_of_line        = lf

# A refinement for bats files
[**.bats]
shell_variant = bats

[**.pm6]
indent_size = 4

[**.py]
# I have a .py file in ~/bin. It's not shell, so I want to undo the ~/bin rule
indent_size = 4
indent_style = space
shell_variant = unset

[**.{md,rst}]
# Trailing whitespace is meaningful to Markdown (and reStructuredText?) files
trim_trailing_whitespace = false

# All git configuration files, in bare, fake-bare, and non-bare repos
[{.git*,**/*.git/config,**/git/config}]
indent_size = tab
indent_style = tab

# Git diff/patch files are sensitive to trailing whitespace
[{.git/*.diff}]
trim_trailing_whitespace = false

# mr config files. I consider them very similar to git config files, but they should be a separate section
[.mrconfig]
trim_trailing_whitespace = false
indent_size = tab
indent_style = tab

# Build-like files seem to enjoy tabs (build.gradle is from spring initializr)
[{Makefile,build.gradle}]
indent_size = tab
indent_style = tab

[*.java]
# Approximately equivalent to IntelliJ default settings
indent_size = 4
max_line_length = 120

