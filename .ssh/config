Include work-config # implicitly looks in ~/.ssh, per `man ssh_config`

# https://docs.aws.amazon.com/systems-manager/latest/userguide/session-manager-getting-started-enable-ssh-connections.html#ssh-connections-enable
Host i-* mi-*
  ProxyCommand sh -c "aws ssm start-session --target %h --document-name AWS-StartSSHSession --parameters 'portNumber=%p'"
  # Not always guaranteed, per https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/connection-prereqs-general.html#connection-prereqs-get-info-about-instance
  User ec2-user
  # This is either a work thing or a generic AWS thing, but either way, it's annoying.
  # Somebody keeps shutting down my connections for idleness. This will send alive packets
  # every 100 seconds. Why 100? I dunno. Feels like that's frequent enough to solve my problem.
  #
  # It's more frequent than BatchMode which uses 300s (5min), but dude, it's like... one packet.
  # I could probably feel fine sending a random packet every second without over-burdening anything.
  ServerAliveInterval 100


host remarkable
  hostname 10.11.99.1
  # dunno:
  # hostname 192.168.223.61

host remarkable-wifi
  hostname 10.0.0.191

host remarkable*
  user root

