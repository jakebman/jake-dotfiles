#! /bin/bash

# I'd like to get a failure of --help to cause a failure of this total command
# This should mean I can fully support bash builtins too
set -o pipefail

function bat-help {
	bat --language help --plain
}

function help-or---help {
	if [ "$#" -eq 1 ]; then
		help "$1" 2> /dev/null || "$1" --help
	else
		"$@" --help
	fi
}
declare args

function help-message {
	echo "runs like the bash help builtin <TODO: more>"
}

while getopts 'dmsh' arg "$@"; do
	case "$arg" in
		h)
			help-message
			exit
			;;
		?)
			help-message
			exit 1
			;;
	esac
	args="${args}${arg}"
done

SHIFT="$OPTIND"
(( SHIFT-- ))
echo "args are '${args}'. Shifting by ${SHIFT}"
shift "$SHIFT"

if [ "$#" -lt 1 ]; then
	if [ -t 0 ]; then
		echo "please redirect --help output into this program, or specify a program to get an implicit --help. The terminal doesn't make much sense for stdin"
		exit 1
	fi
	bat-help
else
	help-or---help "$@" | bat-help
fi
