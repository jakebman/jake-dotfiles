#! /bin/bash

# I'd like to get a failure of --help to cause a failure of this total command
# This should mean I can fully support bash builtins too
set -o pipefail

function bat-help {
	bat --language help --plain
}

function composure-help {
	# requires exactly one arg. Not enforced
	# is a function and composure's reference function or equivalent is available
	if [[ function = "$(type -t "$1")" ]] && type reference &>/dev/null; then
		if [[ -n "$(reference "$1")" ]]; then
			# reference produces output for this function
			reference "$1"

			return 0 # success!
		fi
	fi
	return 1 # failure!
}


function find-help {
	if [ "$#" -eq 1 ]; then
		builtin help "$1" 2> /dev/null ||
			composure-help "$1" ||
			"$1" --help ||
			builtin help "$1"
	else
		"$@" --help
	fi
}
declare args

function help-message {
	echo "runs like the bash help builtin <TODO: more>"
}

if [ "$#" -le 0 ]; then
	if [ -t 0 ]; then
		# Dispatch to builtin help directly:
		builtin help | bat-help
	else
		# stdin isn't a terminal; we're probably coloring another help
		bat-help
	fi
	exit "$?"
fi

while getopts 'dmsh' arg; do
	case "$arg" in
		h)
			help-message
			exit
			;;
		\?)
			help-message
			exit 1
			;;
			# TODO: m) indicates man-page-like output
	esac
	args="${args}${arg}"
done

SHIFT="$OPTIND"
((SHIFT--))
shift "$SHIFT"

if [[ "$SHIFT" -le 0 ]]; then
	# no help-like args. Could be either help or --help
	find-help "$@" | bat-help
else
	# We received help-like arguments. We should just ask the builtin help and not go
	builtin help -"$args" "$@" | bat-help
fi
