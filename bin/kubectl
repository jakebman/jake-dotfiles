#! /bin/bash

# A bin-ified version of the docker autostart bash scripts. This allows makefiles to proc autostart too :)

: "${DOCKER:=/usr/bin/docker}"
: "${KUBECTL:=/usr/local/bin/kubectl}"
: "${BASH_IT_DOCKER_DESKTOP_LOCATION:=/mnt/c/Program Files/Docker/Docker/Docker Desktop.exe}"

_BASH_IT_KUBECTL_AUTOSTART_EXCEPTIONS+=(completion)
# It's worth adding your own exceptions
# _BASH_IT_KUBECTL_AUTOSTART_EXCEPTIONS+=(login loggedin logout)

function _kubectl-autostart-exception {
	# https://stackoverflow.com/questions/3685970/check-if-a-bash-array-contains-a-value
	local exception
	for exception in "${_BASH_IT_KUBECTL_AUTOSTART_EXCEPTIONS[@]}"; do
		if [ "$exception" = "$1" ]; then
			return
		fi
	done
	return 1
}

function kubectl-autostart {
	if _kubectl-autostart-exception "$@"; then
		: _log_debug "Not automatically starting docker to run 'kubectl $@' - it is an exception"
	elif ! docker-is-running; then
		echo "Docker Desktop is not currently running. Starting it now."
		docker-start-and-wait || return
		(cd ~ && git restore .aws && echo "restored ~/.aws from docker's interventions")
		echo
		echo "============= Now proceeding with your original '$1' command =================="
		echo "==>" kubectl "$@"
		echo "============= Now proceeding with your original '$1' command =================="
	fi

	local -a env_args cli
	# Thanks to https://github.com/kubernetes/kubectl/issues/1154 for the names
	env_args=(
		${KUBECTL_CACHE_DIR+--cache-dir="$KUBECTL_CACHE_DIR"}
		${KUBECTL_CONTEXT+--context="$KUBECTL_CONTEXT"}
		${KUBECTL_NAMESPACE+--namespace="$KUBECTL_NAMESPACE"}
		)
	cli=(
		"$KUBECTL"
		"${env_args[@]}"
		"$@"
		)
	if [[ "${#env_args[@]}" -gt 0 || -v KUBECONFIG ]] && [ -t 0 ] && [ -t 2 ]; then
		# TODO: output to >&3 or something if 2 isn't a terminal instead of silencing this
		if [ -v KUBECONFIG ]; then
			echo "KUBECONFIG is:"
			local file files
			IFS=':' read -ra files <<< "$KUBECONFIG"
			if [[ -v KUBECONFIG_DEBUG ]]; then
				for file in "${files[@]}"; do
					echo '---'
					echo "# $file"
					cat "$file"
				done
			else
				printf " * %s\n" "${files[@]}"
			fi
		else
			echo "KUBECONFIG is empty"
		fi
		echo # spacing
		cat <<-MESSAGE
			Jake received ${env_args[*]} from the environment
			running ${cli[*]@Q}
		MESSAGE
		echo # spacing
	fi | sed 's/^/# /g' >&2

	"${cli[@]}" 2> >(_ignore-Certain-Warnings >&2)
}

# I filter out a particularly annoying error message from kubectl
# Name is intentionally ugly, because this is an ugly idea
function _ignore-Certain-Warnings {
	grep \
		--invert-match \
		--line-regexp \
		--fixed-strings \
		"Warning: Use tokens from the TokenRequest API or manually created secret-based tokens instead of auto-generated secret-based tokens."
}

function docker-start {
	"${BASH_IT_DOCKER_DESKTOP_LOCATION}"
	if docker-is-running; then
		echo "Docker desktop is likely already running"
		return 1
	else
		echo "Docker desktop kicked off. Expect the UI in a few seconds"
	fi
}
_BASH_IT_DOCKER_PROGRESS+=('/' '-' '\' '|')
function docker-start-and-wait {
	docker-start || return
	local count index delta=${_BASH_IT_DOCKER_PROGRESS_MS_TICKS:-150}
	until docker-is-running; do
		(( count++ ))
		(( index=count%4 ))
		printf '\r%*s'  $((count/20)) "${_BASH_IT_DOCKER_PROGRESS[$index]}"
		sleep "$(printf '%d.%03d' $((delta/1000)) $((delta%1000)))"
	done
	printf '\r%s\n' '   '
	(( delta *= count ))
	printf '%d.%03d seconds elapased\n' $((delta/1000)) $((delta%1000))
}


function docker-is-running {
	# This is the mechanism by which the '/mnt/c/Program Files/Docker/Docker/resources/bin/docker' file
	# checks to see if the WSL2 integration is present in the current machine.
	[ -f "$DOCKER" ]
}


kubectl-autostart "$@"
