#!/bin/bash

# TODO: this might be able to be rolled into .gitconfig

function helper {
	git config --show-origin --show-scope "$@"
}

function has-flag {
	for param in "$@"; do
		case "$param" in
			-*)
				return 0 # success
				;;
		esac
	done
	return 1 # failure
}

if [ "$#" -eq 0 ]; then
	# implicit all
	helper --list "$@" # empty arg list
elif has-flag "$@"; then
	# caller knows what they *really* want to do here.
	# They'll get the show-origin and show-scope, but nothing more
	helper "$@"
else
	# --get-regex is --get-all, but accepts regex
	for key in "$@"; do
		# TODO: use the new `git config get` syntax
		# TODO: smart-case matching would be nice (specify case insensitive regex if no capitals are in it)
		helper --get-regex "$key"
	done
fi
