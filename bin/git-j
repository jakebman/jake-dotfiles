#!/bin/bash

function help() {
  echo "usage: git j <arguments to git jump grep>"
  echo
  echo "Run a git jump, pass it through fzf and open vim with the chosen lines"
}

function gitj-preview {
  batcat "$1" \
    --highlight-line "$2" \
    --decorations always \
    --color always

  # TODO: --force-colorization when batcat gets to higher versions
}

function gitj-fzf {
 #TODO: variables for the header lines to include
 fzf-0.38 --preview='gitj-preview {+1} {2}' \
     --exit-0 \
     --select-1 \
     --no-sort \
     --reverse \
     --multi \
     --bind 'enter:become(cat {+f})' \
     --preview-window=+{2}-5 \
     --with-nth 1,4.. \
     --delimiter='[ :]'
}

# Since we're a subshell, we don't need to clean up this exported function
# (our parent process doesn't see this - only git, fzf, and vim see it)
export -f gitj-preview

# TODO: figure out how to use become() and {f} to auto-invoke vim -q {+f} like in
# https://github.com/junegunn/fzf#turning-into-a-different-process
# (requires a higher fzf version than is in Ubuntu 20.04)
git jump --stdout grep "$@" | gitj-fzf


