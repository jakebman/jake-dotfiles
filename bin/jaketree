#!/usr/bin/bash

set -o pipefail # allow failure of jaketree.py to propagate outward

# shim to automatically page the jaketree.py output temporarily until I figure out how to make
# the python file itself do auto-pagination
# We disable paging if any of the following is true:
# * Output isn't to a terminal
# * We have no arguments, and yet stdin is a terminal (this is a testing scenario)

if [ ! -t 1 ]; then
	# no terminal output
	jaketree.py "$@"
elif [ "$#" -eq 0 ] && [ -t 0 ]; then
	# no arguments, but stdin is a terminal
	# Probably testing
	jaketree.py "$@"
else
	jaketree.py "$@" | pager
fi
