#! /bin/bash

# A shortened name for this script, in case diagnostics are required
# based on the principle of https://stackoverflow.com/a/246128
#THIS_SCRIPT="$(realpath ${BASH_SOURCE[0]:-$0})"
# condenses $HOME to ~, per https://superuser.com/questions/512061/how-to-get-foo-from-home-user1-foo/512078#512078
#THIS_SCRIPT="${THIS_SCRIPT/~/\~}"
# Short-cutted, for speed:
THIS_SCRIPT="Jake's ~/bin/git"

# TODO: respect --git-dir, which takes precedence over either GIT_DIR or PWD.
# And be sure to set that value into GIT_DIR, or otherwise respect it below
# where we sometimes assume an empty GIT_DIR should really be BASH_IT_DOTFILES_GIT_REPO
# It's not a big deal, but it does embarass the output in corner cases
WHERE="${GIT_DIR:-${PWD:-$(pwd)}}"

GIT=/usr/bin/git
WHICH=WSL

# Improve ^C behavior - print out this diagnostic/status message even if th user cancels the command
if [ -t 1 ] ; then # we're running in a terminal
  trap 'echo "(This command used ${WHICH}'"'"'s ${GIT}${HOW}. Indirection provided by ${THIS_SCRIPT})"' EXIT
fi


function handleInWindowsDirectory {
  echo "$$ is in windows directory" >> ~/git-commands
  case "$1" in
    config )
      echo "$$ is in special situation" >> ~/git-commands
      # WSL's git is faster for this, but we need to know to read
      # Window's config file roots
      HOW=", reading Window's GIT_CONFIG_* variables"
      export GIT_CONFIG_SYSTEM='/mnt/c/Program Files/Git/etc/gitconfig'
      # :? fails if the variable is unset, with a reasonable error
      export GIT_CONFIG_GLOBAL="${WSL_WINDOWS_USER_HOME:?}/.gitconfig"
    ;;
    *)
      echo "$$ is in bare situation" >> ~/git-commands
      WHICH=Windows
      GIT=git.exe
    ;;
  esac
}

if [ "$#" -eq 0 ] ; then
  : # do nothing - keep $GIT at linux
elif [ "$1" == "symbolic-ref" ] ; then
  : # do nothing - WSL reads symbolic refs faster than windows
  # We could eventually add this, but it feels unnecessary right now:
  # GIT_CONFIG_SYSTEM='/mnt/c/Program Files/Git/etc/gitconfig'
else
  case "$(realpath "$WHERE")" in
    /mnt/c/*)
      handleInWindowsDirectory;;
  esac
fi

# Fallback to check my `config` dotfiles repo when I'm not thinking super hard about it
if [ -n "$GIT_DIR" ] ; then
  HOW="${HOW}, respecting received GIT_DIR='${GIT_DIR/~/\~}'"
elif [ "$WHICH" == WSL ] && [ -z "$HOW" ] && [ "$1" != clone ] && [ "$1" != init ] && ! "$GIT" rev-parse &>/dev/null ; then
  # Only check for this if we're in WSL-land, because it's slow to check with Window's git.exe
  # ... not even if we're using WSL-git for faster config reading
  # ...    nor   if we'd overwrite a different GIT_DIR
  # ... and FOR SURE not if we're trying to clone or init!
  # Finally, a fast-failing git command (rev-parse works) tells us that we're outside any other repo

  # condenses $HOME to ~, per https://superuser.com/questions/512061/how-to-get-foo-from-home-user1-foo/512078#512078
  HOW=", assuming the GIT_DIR for ${BASH_IT_DOTFILES_GIT_REPO/~/\~}"
  # :? fails if the variable is unset, with a reasonable error
  export GIT_DIR="${BASH_IT_DOTFILES_GIT_REPO:?}"

  # TODO: I'd like to export this to pair with GIT_DIR, but the currently-working situation is to set core.worktree on my repo instead
  # (libgit2, used by git2-rs, and ultimately bat chokes if this variable is set, but respects core.worktree, which I recommend
  # in the bash-it repo plugin for this setup)
  # export GIT_WORK_TREE="$HOME"
fi


echo "$$ - git" "$@" >> ~/git-commands
"$GIT" "$@"
EXIT_CODE=$?
echo "$$ exiting with $EXIT_CODE" >> ~/git-commands
exit $EXIT_CODE


