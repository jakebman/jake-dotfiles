#! /bin/bash

# A shortened name for this script, in case diagnostics are required
# based on the principle of https://stackoverflow.com/a/246128
#THIS_SCRIPT="$(realpath ${BASH_SOURCE[0]:-$0})"
# condenses $HOME to ~, per https://superuser.com/questions/512061/how-to-get-foo-from-home-user1-foo/512078#512078
#THIS_SCRIPT="${THIS_SCRIPT/~/\~}"
# Short-cutted, for speed:
THIS_SCRIPT="Jake's ~/bin/git"


# TODO: a mechanism by which I can 'lock' this script to unix-land or windows-land
# TODO: respect --git-dir, --work-tree, and -C, which take precedence over either GIT_DIR or PWD.
# (See the git man entry for -C, and https://stackoverflow.com/a/35899275 for details)
# And be sure to set that value into GIT_DIR, or otherwise respect it below
# where we sometimes assume an unset GIT_DIR should really be BASH_IT_DOTFILES_GIT_REPO
# It's not a big deal, but it does embarass the output in corner cases
# NB: $WHERE here can either equal $GIT_DIR or $GIT_WORK_TREE. That will be
# confusing if this variable is used as-if it were one and not the other.
# (It's fine for the use of this variable, which is only for user output)
WHERE="${GIT_DIR:-${PWD:-$(pwd)}}"

GIT=/usr/bin/git
WHICH=WSL

# Reify the values for these variables to their documented default values from `man vcsh`:
: ${XDG_CONFIG_HOME:=${HOME}/.config}
: ${VCSH_REPO_D:=${XDG_CONFIG_HOME}/vcsh/repo.d}

# condenses $HOME to ~, per https://superuser.com/questions/512061/how-to-get-foo-from-home-user1-foo/512078#512078
# plus vcsh, plus any others that might be relevant in the future
function summarize_path {
  local first="${1/#$VCSH_REPO_D\//\$VCSH_REPO_D/}"
  echo "${first/~/\~}"
}

# Improve ^C behavior - print out this diagnostic/status message even if the user cancels the command
# TODO: Respect -q / --quiet, and suppress this output if we're quiet
# For now (infamous temp fix that will last forever), I am suppressing output when run through `mr`
# Even more infamously, a less-documented environment variable
# NB: mr does pass --quiet through to us, so we will be able to rely on that
# Further consideration could go into a magic parameter setup (git -c jake.custom.indirection.disableMessage) that
# can act as a "quiet, but for this callout only"
# Further TODO: call out what command was eventually invoked, with env variables, if some debug indications are present
if [ -t 1 ] && [ -z "$MR_REPO" ] && [ -z "$JAKE_SUPPRESS_GIT_SQUAWK" ] ; then # we're running in a terminal, and not from `mr`
  trap 'echo "(This command used ${WHICH}'"'"'s ${GIT}${HOW}. Indirection provided by ${THIS_SCRIPT})"' EXIT
fi

# TODO: I'd like to add implicitdiff to the list of commands which use /usr/bin/git, but respect windows dirs
# This ad-hoc jumble isn't really condusive to adding more pieces. Perhaps a series of flags (which could be received from
# the parent environment) could help make the fallback choices clearer.
if [ "$#" -eq 0 ] ; then
  : # do nothing - keep $GIT at linux
elif [ "$1" == "symbolic-ref" ] || [ "$1" == "help" ] ; then
  : # do nothing - WSL reads symbolic refs faster than windows
  # We could eventually add this, but it feels unnecessary right now:
  # GIT_CONFIG_SYSTEM='/mnt/c/Program Files/Git/etc/gitconfig'
else
  case "$(realpath "$WHERE")" in
    /mnt/c/*)
      if  [ "$1" == "config" ] ; then
        # WSL's git is faster for this, but we need to know to read
        # Window's config file roots
        HOW=", reading Window's GIT_CONFIG_* variables"
        export GIT_CONFIG_SYSTEM='/mnt/c/Program Files/Git/etc/gitconfig'
        # :? fails if the variable is unset, with a reasonable error
        export GIT_CONFIG_GLOBAL="${WSL_WINDOWS_USER_HOME:?}/.gitconfig"
      else
        WHICH=Windows
        GIT=git.exe
      fi
      ;;
   *)
  esac
fi

# Fallback to check my `config` dotfiles repo when I'm not thinking super hard about it
if [ -n "$GIT_DIR" ] ; then
  HOW="${HOW}, respecting received GIT_DIR='$(summarize_path "$GIT_DIR")'"
elif [ "$WHICH" == WSL ] && [ -z "$HOW" ] && [ "$1" != clone ] && [ "$1" != init ] && ! "$GIT" rev-parse &>/dev/null ; then
  # Only check for this if we're in WSL-land, because it's slow to check with Window's git.exe
  # ... not even if we're using WSL-git for faster config reading
  # ...    nor   if we'd overwrite a different GIT_DIR
  # ... and FOR SURE not if we're trying to clone or init!
  # Finally, a fast-failing git command (rev-parse works) tells us that we're outside any other repo

  HOW=", assuming the GIT_DIR for $(summarize_path "$BASH_IT_DOTFILES_GIT_REPO")"
  # :? fails if the variable is unset, with a reasonable error
  export GIT_DIR="${BASH_IT_DOTFILES_GIT_REPO:?}"

  # TODO: I'd like to export this to pair with GIT_DIR, but the currently-working situation is to set core.worktree on my repo instead
  # (libgit2, used by git2-rs, and ultimately bat chokes if this variable is set, but respects core.worktree, which I recommend
  # in the bash-it repo plugin for this setup)
  # export GIT_WORK_TREE="$HOME"
fi


echo "$$ (in $PWD) - git" "$@" >> ~/git-commands
"$GIT" "$@"
EXIT_CODE=$?
echo "$$ exiting with $EXIT_CODE" >> ~/git-commands
exit $EXIT_CODE


