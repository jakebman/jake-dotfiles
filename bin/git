#! /bin/bash

# A shortened name for this script, in case diagnostics are required
# based on the principle of https://stackoverflow.com/a/246128
#THIS_SCRIPT="$(realpath ${BASH_SOURCE[0]:-$0})"
# condenses $HOME to ~, per https://superuser.com/questions/512061/how-to-get-foo-from-home-user1-foo/512078#512078
#THIS_SCRIPT="${THIS_SCRIPT/~/\~}"
# Short-cutted, for speed:
THIS_SCRIPT="Jake's ~/bin/git"

# TODO: a mechanism by which I can 'lock' this script to unix-land or windows-land
# TODO: respect --git-dir, --work-tree, and -C, which take precedence over either GIT_DIR or PWD.
# (See the git man entry for -C, and https://stackoverflow.com/a/35899275 for details)
# NB: the behavior of this git with -C is incredibly hilarious. The implicit GIT_DIR from ~ is used
#     but the status is reported as-if you're running git in the folder specified by -C
# And be sure to set that value into GIT_DIR, or otherwise respect it below
# where we sometimes assume an unset GIT_DIR should really be BASH_IT_DOTFILES_GIT_REPO
# It's not a big deal, but it does embarass the output in corner cases
# NB: $WHERE here can either equal $GIT_DIR or $GIT_WORK_TREE. That will be
# confusing if this variable is used as-if it were one and not the other.
# (It's fine for the use of this variable, which is only for user output)
WHERE="${GIT_DIR:-${PWD:-$(pwd)}}"

GIT=/usr/bin/git
WHICH=WSL

# Reify the values for these variables to their documented default values from `man vcsh`:
: ${XDG_CONFIG_HOME:=${HOME}/.config}
: ${VCSH_REPO_D:=${XDG_CONFIG_HOME}/vcsh/repo.d}

# condenses $HOME to ~, per https://superuser.com/questions/512061/how-to-get-foo-from-home-user1-foo/512078#512078
# plus vcsh, plus any others that might be relevant in the future
function summarize_path {
	local first="${1/#${VCSH_REPO_D}\//\${VCSH_REPO_D\}/}"
	echo "${first/~/\~}"
}

# Improve ^C behavior - print out this diagnostic/status message even if the user cancels the command
# TODO: Respect -q / --quiet, and suppress this output if we're quiet
# For now (infamous temp fix that will last forever), I am suppressing output when run through `mr`
# Even more infamously, a less-documented environment variable
# NB: mr does pass --quiet through to us, so we will be able to rely on that
# Further consideration could go into a magic parameter setup (git -c jake.custom.indirection.disableMessage) that
# can act as a "quiet, but for this callout only"
if [ -t 1 ] && [ -z "$MR_REPO" ] && [ -z "$JAKE_SUPPRESS_GIT_SQUAWK" ]; then # we're running in a terminal, and not from `mr`
	# TODO: use printf instead?
	trap 'echo "(${THIS_SCRIPT} used ${WHICH}'"'"'s ${GIT}${HOW+${HOW}.})"; [ -v NOTES ] && echo "${NOTES}"' EXIT
fi

declare -A ALWAYS_WSL_COMMANDS

# the value isn't necessary - we're causing them to be set, which is what -v tests for
ALWAYS_WSL_COMMANDS[config]=
ALWAYS_WSL_COMMANDS[help]=
ALWAYS_WSL_COMMANDS[symbolic-ref]=

# git-extras commands (TODO: the rest)
ALWAYS_WSL_COMMANDS[ignore-io]=

# My own ~/bin commands, which aren't in window
ALWAYS_WSL_COMMANDS[config-debug]=
ALWAYS_WSL_COMMANDS[dump-env]='' # Huh. I don't have a record of this command. Potentially ad-hoc, and never added to git?
ALWAYS_WSL_COMMANDS[export]=
ALWAYS_WSL_COMMANDS[jump]='' # technically vendored
# My ~/bin commands that are broken or otherwise weird if running from wsl in windows repos
#ALWAYS_WSL_COMMANDS[j]= # takes a (too) long time to get the list of files
#ALWAYS_WSL_COMMANDS[implicitdiff]= # I don't know. Shortcutted this by aliasing it to plain git-diff in windows-land
# TODO: tab completion isn't... able to follow what I'm doing here. Anything I can do to help it along?

# TODO: git doesn't allow us to override builtins with aliases. I figure an [alias "allow-override-builtins"] section might be nice to read from here?
# Or, write an alias that... figures out which aliases can work?
# See https://stackoverflow.com/questions/3538774/is-it-possible-to-override-git-command-by-git-alias for discussion.
# Git is valid to not do this. I might figure out a way that makes sense for me. A la `alias git="GIT_IS_ON_CLI_AND_PERMITS_ALIASES_TO_OVERRIDE_BUILTINS=1 git "` or `alias git='git allow-aliases'`?
# plus a `git-unaliased` command which... sets that to zero or otherwise makes it inapplicable

# Windows dirs are exported to WSL via v9fs. This is the fastest check I can run
if [[ v9fs = "$(stat --file-system . --format=%T)" ]]; then
	IS_WINDOWSY=true

	# Impl. note: $1 isn't guaranteed to be defined here, but that is fine - it'll just be the empty string
	if [[ -v "ALWAYS_WSL_COMMANDS[$1]" ]]; then
		WINDOWSY_CONFIGS=true
		# Window's config file roots
		HOW=", reading Window's GIT_CONFIG_* variables"
		export GIT_CONFIG_SYSTEM='/mnt/c/Program Files/Git/etc/gitconfig'

		# the windows-user-home symlink isn't guaranteed to exist
		export GIT_CONFIG_GLOBAL="${XDG_CONFIG_HOME:-${HOME}/.config}/jake/windows-user-home/.gitconfig"
		if [[ ! -d "$(dirname "$GIT_CONFIG_GLOBAL")" ]]; then
			>&2 echo "Jake Warning: the symlink to windows doesn't seem to be working: $(dirname "$GIT_CONFIG_GLOBAL")"
		fi
	else
		WHICH=Windows
		GIT=git.exe
	fi
fi

# Fallback to check my `config` dotfiles repo, but only when I'm not thinking super hard about it
# (let an explicit choice override my implicit choice)
if [ -v GIT_DIR ]; then
	HOW+=". Received GIT_DIR=\"$(summarize_path "$GIT_DIR")\""
elif ! [ -v IS_WINDOWSY ] && [ "$1" != clone ] && [ "$1" != init ] && ! "$GIT" rev-parse &> /dev/null; then
	# Only check for this if we're in WSL-land and not windows-y - even rev-parse is 4x slower via git.exe and it feels weird to do this fallback across FS boundaries anyway
	# ... not even if we're using WSL-git for faster config reading
	# ...    nor   if we'd overwrite a different GIT_DIR
	# ... and FOR SURE not if we're trying to clone or init!
	# Finally, a fast-failing git command (rev-parse works) tells us that we're outside any other repo

	# TODO: better message if BASH_IT_DOTFILES_GIT_REPO is unset (for some reason?)
	HOW+=". Implicit GIT_DIR=\"$(summarize_path "$BASH_IT_DOTFILES_GIT_REPO")\""
	# TODO: potentially also call out "GIT_WORK_TREE unset, but `core.worktree` is ..."
	# :? fails if the variable is unset, with a reasonable error
	export GIT_DIR="${BASH_IT_DOTFILES_GIT_REPO:?}"

	# TODO: I'd like to export this to pair with GIT_DIR, but the currently-working situation is to set core.worktree on my repo instead
	# (libgit2, used by git2-rs, and ultimately bat chokes if this variable is set, but respects core.worktree, which I recommend
	# in the bash-it repo plugin for this setup)
	# export GIT_WORK_TREE="$HOME"
fi

# include additional notes if the command looks like it includes a help-like part
if [[ "x $*" =~ "help" ]]; then

	if [[ -v GIT_DIR ]]; then
		SUMMARIZED="$(summarize_path "$GIT_DIR")"
		NOTES+="GIT_DIR=\"${SUMMARIZED}\""
		if [[ "x${SUMMARIZED}" =~ 'VCSH_REPO_D' ]]; then # was summarized
			# wonky phrasing for "pre-catenate, with a space between, but it feels like the cleanest phrasing
			printf -v NOTES '%s %s' 'VCSH_REPO_D="${VCSH_REPO_D:-${XDG_CONFIG_HOME:-${HOME}/.config}/vcsh/repo.d}"' "$NOTES"
		fi
	fi

	if [[ -v WINDOWSY_CONFIGS ]]; then
		NOTES+=' GIT_CONFIG_GLOBAL="${XDG_CONFIG_HOME:-${HOME}/.config}/jake/windows-user-home/.gitconfig"'
		NOTES+=" GIT_CONFIG_SYSTEM='/mnt/c/Program Files/Git/etc/gitconfig'"
	fi

	# We have reasonable belief that there are env vars to print out about our invocation line
	if [[ -v NOTES ]]; then
		HOW+=". Invocation information below"
		NOTES+=" ${GIT}"
	else
		HOW+=". No custom environment variables necessary"
	fi
fi

echo "$$ (in $PWD) - git" "$@" >> ~/git-commands
"$GIT" "$@"
EXIT_CODE=$?

if (( $EXIT_CODE == 141 )); then
	echo "$$ wants to exit with ${EXIT_CODE}, but that's SIGPIPE, which I want to succeed. exiting with 0 instead." >> ~/git-commands
	NOTES+="${NOTES:+\n}(Enhanced behavior: SIGPIPE was translated to success)"
	exit 0
else
	echo "$$ exiting with $EXIT_CODE" >> ~/git-commands
	exit $EXIT_CODE
fi
