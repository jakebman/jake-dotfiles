#!/bin/bash

function help() {
  echo "usage: j <arguments to ack>"
  echo "usage: j --diff <arguments to git (jump) diff>"
  echo "usage: j --ws <arguments to git jump ws>"
  echo "usage: j -q <quickfix file>"

  echo
  echo "Run an ack query, pass it through fzf and open vim with the chosen lines"
  echo "OR: run a git (jump) diff through fzf ..."
  echo "OR: run a git (jump) ws through fzf ... (finds whitespace errors)"
  echo "OR: pass a quickfix file ..."
}

function j-preview {
  batcat "$1" \
    --highlight-line "$2" \
    --decorations always \
    --color always

  # TODO: --force-colorization when batcat gets to higher versions
}

function j-fzf {
 #TODO: variables for the header lines to include
 fzf --preview='j-preview {+1} {2}' \
     --exit-0 \
     --select-1 \
     --no-sort \
     --reverse \
     --multi \
     --preview-window=+{2}-5,~3 \
     --with-nth 1,4.. \
     --delimiter='[ :]'
}

function j-git-jump-diff {
  # Leverage our last mode, and pass ourselves as the editor that git jump will use
  # TODO: this might not be necessary if we just use --stdout
  GIT_EDITOR="$0" git jump diff "$@"
}

function j-git-jump-ws {
  # Leverage our last mode, and pass ourselves as the editor that git jump will use
  # TODO: this might not be necessary if we just use --stdout
  GIT_EDITOR="$0" git jump ws "$@"
}


# Since we're a subshell, we don't need to clean up this exported function
# (our parent process doesn't see this - only ack, fzf, and vim see it)
export -f j-preview

# TODO: figure out how to use become() and {f} to auto-invoke vim -q {+f} like in
# https://github.com/junegunn/fzf#turning-into-a-different-process
# (requires a higher fzf version than is in Ubuntu 20.04)
# There is code in the fzf-0.38 branch that does this the above "right" way
# Until then, we must use a mktemp plan

if TEMPFILE=$(mktemp --tmpdir jake-j-jumping-tool.XXXXXX); then
  trap 'rm "$TEMPFILE"' EXIT
else
  echo >&2 "Could not create temporary file :("
  exit 100
fi

# TODO: "no args" could be considered implicitly "search everything", but only if we're
# not in the root dir or something
if [ "$#" -eq 0 ] ; then
  help
  echo
  echo "please specify search terms to get a successful search"
  exit 1
fi

case $1 in
  # We're emulating vim, but passing our argument to fzf to get to TEMPFILE, then finally to vim
  -q) shift ; cat "$@" | j-fzf >"$TEMPFILE" ;;

  # We delegate the 'find the quickfixes' task to `git jump diff`, which then delegates its editing
  # to a second copy of this script.
  # Confusing. Convoluted. Works.
  --diff) shift ; j-git-jump-diff "$@" ; exit $? ;;

  # Ditto, but for whitespace checking
  --ws) shift ; j-git-jump-ws "$@" ; exit $? ;;

  # help command
  --help|-h) help ; exit ;;

  # Every other execution mode delegates directly to ack for "find the quickfixes", which then get
  # filtered by fzf
  *) ack --column "$@" | j-fzf >"$TEMPFILE" ;;
esac
RET=$?

if [ "$RET" -eq 0 ] ; then
  vim -q "$TEMPFILE" && echo successfully edited: && cat "$TEMPFILE"
else
  # TODO: fzf has multiple exit codes
  echo "Failed to search with $(basename $0) for $@"
  exit $RET
fi

