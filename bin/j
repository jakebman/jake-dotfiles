#!/bin/bash

function help() {
  echo "usage: j (no arguments, implies --diff)"
  echo "usage: j <arguments to ack>"
  echo "usage: j ack <arguments to ack>"
  echo "usage: j --diff <arguments to git (jump) diff>"
  echo "usage: j --ws <arguments to git jump ws>"
  echo "usage: j -q <quickfix file>"

  echo
  echo "Run an ack query, pass it through fzf and open vim with the chosen lines"
  echo " (for convenience, you can !! the ack command you just ran, instead of just !* its arguments)"
  echo "OR: run a git (jump) diff through fzf ..."
  echo "OR: run a git (jump) ws through fzf ... (finds whitespace errors)"
  echo "OR: pass a quickfix file ..."
  echo "As a heads-up - typing q immediately quits the search."
}

function j-preview {
  # TODO: it'd be nice if bat respected GIT_DIR for change highlighting
  bat "$1" \
    --highlight-line "$2" \
    --pager "less --mouse" \
    --force-colorization # sets both --decoration and --color to `always`
}

function j-fzf-common {
 fzf --preview='j-preview {1} {2}' \
     --ansi \
     --exit-0 \
     --select-1 \
     --no-sort \
     --reverse \
     --multi \
     --header "Ctrl+Space to preview" \
     --bind "ctrl-space:execute(vim -q <(echo {}) </dev/tty >/dev/tty)" \
     --bind "ctrl-a:select-all" \
     --bind "ctrl-n:deselect-all" \
     --bind "q:abort" \
     --bind "change:unbind(q)" \
     --preview-window=+{2}+3/3,~3 \
     --delimiter=':' \
     "$@"
}

# with column selection, we hide columns 2 & 3
function j-fzf-ack {
  j-fzf-common --with-nth 1,4..
}

# with no column selection, we only need to hide column 2
function j-fzf-diff {
  j-fzf-common --with-nth 1,3..
}

# Since we're a subshell, we don't need to clean up this exported function
# (our parent process doesn't see this - only ack, fzf, and vim see it)
export -f j-preview

# TODO: figure out how to use become() and {f} to auto-invoke vim -q {+f} like in
# https://github.com/junegunn/fzf#turning-into-a-different-process
# (requires a higher fzf version than is in Ubuntu 20.04)
# There is code in the fzf-0.38 branch that does this the above "right" way
# Until then, we must use a mktemp plan

if TEMPFILE=$(mktemp --tmpdir jake-j-jumping-tool.XXXXXX); then
  trap 'rm "$TEMPFILE"' EXIT
else
  echo >&2 "Could not create temporary file :("
  exit 100
fi

# TODO: "no args" could be considered implicitly "search everything", but only if we're
# not in the root dir or something
if [ "$#" -eq 0 ] ; then
  # implicitly do a --jump
  git jump --stdout diff "$@" | j-fzf-diff >"$TEMPFILE"
else
  case $1 in
    # We're emulating vim, but passing our argument to fzf to get to TEMPFILE, then finally to vim
    -q) shift ; cat "$@" | j-fzf >"$TEMPFILE" ;;

    # we're getting git-jump's diff lines, and filtering them
    --diff) shift ; git jump --stdout diff "$@" | j-fzf-diff >"$TEMPFILE" ;;

    # ditto, but for whitespace errors
    --ws) shift ; git jump --stdout ws "$@" | j-fzf-diff >"$TEMPFILE" ;;

    # help command
    --help|-h) help ; exit ;;

    # special 'leading ack' case, where I went `j !!` instead of `j !*`
    ack) shift ; ack --color --column "$@" | j-fzf-ack >"$TEMPFILE" ;;

    # Every other execution mode delegates directly to ack for "find the quickfixes", which then get
    # filtered by fzf
    # TODO: respect GIT_WORK_DIR and git ls-files (nb: ack -x doesn't respect --type arguments)
    *) ack --color --column "$@" | j-fzf-ack >"$TEMPFILE" ;;
  esac
fi
RET=$?

# $RET is the return code of fzf (not ack, git-jump, or others), because
# we don't have PIPEFAIL set
if [ "$RET" -eq 0 ] ; then
  # Successful search

  if ! [ -t 0 ] ; then
    echo "$(basename "$0") - stdin not from /dev/tty - reopening"
    exec </dev/tty
  fi

  # run vim, and update our success variable
  vim -q "$TEMPFILE" && echo successfully edited: && cat "$TEMPFILE"
  RET=$?
elif [ "$RET" -eq 1 ] ; then
  echo "No matches found"
elif [ "$RET" -eq 2 ] ; then
  echo "error in fzf"
elif [ "$RET" -eq 130 ] ; then
  echo "(cancelled by user)"
else
  echo "Failed to search with $(basename $0) for $@"
fi

exit $RET
