  # <no suffix for this> ) lexer=twig ;;
  *.ts) lexer=typescript ;;
  # <no suffix for this> ) lexer=typoscriptcssdata ;;
  # <no suffix for this> ) lexer=typoscripthtmldata ;;
  *.typoscript) lexer=typoscript ;;
  *.ul4) lexer=ul4 ;;
  *.u|*.u1|*.u2) lexer=ucode ;;
  *.icn) lexer=unicon ;;
  # <no suffix for this> ) lexer=unixconfig ;;
  *.u) lexer=urbiscript ;;
  *.usd|*.usda) lexer=usd ;;
  *.vbs|*.VBS) lexer=vbscript ;;
  *.vcl) lexer=vcl ;;
  # <no suffix for this> ) lexer=vclsnippets ;;
  # <no suffix for this> ) lexer=vctreestatus ;;
  *.rpf) lexer=vgl ;;
  *.vala|*.vapi) lexer=vala ;;
  *.aspx|*.asax|*.ascx|*.ashx|*.asmx|*.axd) lexer=aspx-vb ;;
  *.vb|*.bas) lexer=vb.net ;;
  # <no suffix for this> ) lexer=html+velocity ;;
  *.vm|*.fhtml) lexer=velocity ;;
  # <no suffix for this> ) lexer=xml+velocity ;;
  *.v) lexer=verilog ;;
  *.vhdl|*.vhd) lexer=vhdl ;;
  *.vim|.vimrc|.exrc|.gvimrc|_vimrc|_exrc|_gvimrc|vimrc|gvimrc) lexer=vim ;;
  *.wdiff) lexer=wdiff ;;
  *.wat|*.wast) lexer=wast ;;
  *.webidl) lexer=webidl ;;
  *.whiley) lexer=whiley ;;
  *.x10) lexer=x10 ;;
  *.xmlul4) lexer=xml+ul4 ;;
  *.xqy|*.xquery|*.xq|*.xql|*.xqm) lexer=xquery ;;
  *.xml.j2|*.xml.jinja2) lexer=xml+django ;;
  # <no suffix for this> ) lexer=xml+ruby ;;
  *.xml|*.xsl|*.rss|*.xslt|*.xsd|*.wsdl|*.wsf) lexer=xml ;;
  # <no suffix for this> ) lexer=xml+php ;;
  # <no suffix for this> ) lexer=xml+smarty ;;
  xorg.conf) lexer=xorg.conf ;;
  *.xsl|*.xslt|*.xpl) lexer=xslt ;;
  *.xtend) lexer=xtend ;;
  *.xtm) lexer=extempore ;;
  *.sls|*.yaml.j2|*.yml.j2|*.yaml.jinja2|*.yml.jinja2) lexer=yaml+jinja ;;
  *.yaml|*.yml) lexer=yaml ;;
  *.yang) lexer=yang ;;
  *.zeek|*.bro) lexer=zeek ;;
  *.zep) lexer=zephir ;;
  *.zig) lexer=zig ;;
  *.ans) lexer=ansys ;;
esac
[ "$lexer" = 'unknown' ] && exit 1 # set above

pygmentize -f 256 -O style="${LESSSTYLE:-default}" "$1"
