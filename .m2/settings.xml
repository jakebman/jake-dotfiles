<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0   http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <localRepository>${WSL_WINDOWS_USER_HOME}/.m2/repository</localRepository>
   <!-- These mirrors are to get around http blocker in maven. These Charter-internal repos are safe -->
    <mirrors>
        <mirror>
              <id>local-repository-mirror</id>
              <mirrorOf>local-nns-artifactory</mirrorOf>
              <name>Pseudo repository to mirror internal nns repositories initially using HTTP.</name>
              <url>http://96.37.182.105:8081/artifactory/nns-local</url>
        </mirror>
        <mirror>
              <id>nexus-public-mirror</id>
              <mirrorOf>nexus-public,nexus-nns-public,jitpack.io</mirrorOf>
              <name>Pseudo repository to mirror internal nns repositories initially using HTTP.</name>
              <url>http://nexus.ctec.charterlab.com/content/groups/public</url>
        </mirror>
        <mirror>
              <id>nexus-public-snapshots-mirror</id>
              <mirrorOf>nexus-public-snapshots,nexus-public-nns-snapshots</mirrorOf>
              <name>Pseudo repository to mirror internal nns repositories initially using HTTP.</name>
              <url>http://nexus.ctec.charterlab.com/content/groups/public-snapshots</url>
        </mirror>
    </mirrors>
    <pluginGroups>
        <pluginGroup>org.sonarsource.scanner.maven</pluginGroup>
    </pluginGroups>
</settings>
